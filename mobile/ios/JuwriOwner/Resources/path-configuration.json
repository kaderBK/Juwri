{
    "settings": {
        "version": 2,
        "account_deletion_path": "/settings/delete-account"
    },
    "rules": [
        {
            "patterns": [
                ".*"
            ],
            "properties": {
                "context": "default",
                "pull_to_refresh_enabled": true
            }
        },
        {
            "patterns": [
                "/new$",
                "/create$",
                "/edit$",
                "/new\\?",
                "/create\\?",
                "/edit\\?"
            ],
            "properties": {
                "context": "modal",
                "pull_to_refresh_enabled": false,
                "modal_style": "large"
            }
        },
        {
            "patterns": [
                "^/login",
                "^/[a-z]{2}/login"
            ],
            "properties": {
                "context": "default",
                "presentation": "replace_root",
                "view_controller": "login"
            }
        },
        {
            "patterns": [
                "/recede_historical_location$"
            ],
            "properties": {
                "presentation": "pop"
            }
        },
        {
            "patterns": [
                "/resume_historical_location$"
            ],
            "properties": {
                "presentation": "none"
            }
        },
        {
            "patterns": [
                "/refresh_historical_location$"
            ],
            "properties": {
                "presentation": "refresh"
            }
        }
    ]
}
