 "settings": [
  {
   "include": "tokens",
   "fields": {
    "colors.primary": {
     "default": "#111111"
    },
    "colors.background": {
     "default": "#FFFFFF"
    },
    "colors.surface": {
     "default": "#FFFFFF"
    },
    "colors.text": {
     "default": "#111111"
    },
    "colors.accent": {
     "default": "#C8281B"
    },
    "layout.radius": {
     "default": "soft"
    },
    "layout.density": {
     "default": "cozy"
    },
    "fonts.pair": {
     "default": "inter"
    }
   }
  },
  {
   "group": "Appearance",
   "icon": "contrast",
   "fields": [
    {
     "id": "scheme.mode",
     "type": "select",
     "label": "Colour scheme",
     "options": [
      "light",
      "dark",
      "auto"
     ],
     "option_labels": {
      "light": "Light",
      "dark": "Dark",
      "auto": "Follow the device"
     },
     "default": "auto",
     "help": "Auto follows the visitor's phone or computer setting."
    },
    {
     "id": "colors_dark.primary",
     "type": "color",
     "label": "Brand colour (dark)",
     "default": "#F5F5F5",
     "visible_if": {
      "scheme.mode": [
       "dark",
       "auto"
      ]
     }
    },
    {
     "id": "colors_dark.background",
     "type": "color",
     "label": "Background (dark)",
     "default": "#0C0C0D",
     "visible_if": {
      "scheme.mode": [
       "dark",
       "auto"
      ]
     }
    },
    {
     "id": "colors_dark.surface",
     "type": "color",
     "label": "Card surface (dark)",
     "default": "#161618",
     "visible_if": {
      "scheme.mode": [
       "dark",
       "auto"
      ]
     }
    },
    {
     "id": "colors_dark.text",
     "type": "color",
     "label": "Text colour (dark)",
     "default": "#F5F5F5",
     "visible_if": {
      "scheme.mode": [
       "dark",
       "auto"
      ]
     }
    },
    {
     "id": "colors_dark.accent",
     "type": "color",
     "label": "Accent colour (dark)",
     "default": "#FF6B5E",
     "visible_if": {
      "scheme.mode": [
       "dark",
       "auto"
      ]
     }
    }
   ]
  },
  {
   "group": "Layout",
   "icon": "layout",
   "fields": [
    {
     "id": "layout.card",
     "type": "select",
     "label": "Item card",
     "options": [
      "list",
      "grid",
      "compact"
     ],
     "option_labels": {
      "list": "List",
      "grid": "Grid",
      "compact": "Compact (no image)"
     },
     "default": "grid"
    },
    {
     "id": "layout.image_ratio",
     "type": "select",
     "label": "Image shape",
     "options": [
      "1:1",
      "4:3",
      "16:9",
      "4:5",
      "3:4"
     ],
     "option_labels": {
      "1:1": "Square",
      "4:3": "4:3",
      "16:9": "16:9",
      "4:5": "Portrait 4:5",
      "3:4": "Portrait 3:4"
     },
     "default": "4:5"
    },
    {
     "id": "layout.category_nav",
     "type": "select",
     "label": "Categories",
     "options": [
      "chips",
      "tabs"
     ],
     "option_labels": {
      "chips": "Chips",
      "tabs": "Tabs"
     },
     "default": "chips"
    },
    {
     "id": "layout.header",
     "type": "select",
     "label": "Header",
     "options": [
      "cover",
      "compact"
     ],
     "option_labels": {
      "cover": "Cover image",
      "compact": "Compact"
     },
     "default": "compact"
    },
    {
     "id": "layout.desktop_cart",
     "type": "select",
     "label": "Cart on desktop",
     "options": [
      "panel",
      "drawer"
     ],
     "option_labels": {
      "panel": "Side panel",
      "drawer": "Drawer"
     },
     "default": "drawer"
    }
   ]
  },
  {
   "group": "Content",
   "icon": "list",
   "fields": [
    {
     "id": "menu.show_descriptions",
     "type": "toggle",
     "label": "Show item descriptions",
     "default": true
    },
    {
     "id": "menu.show_calories",
     "type": "toggle",
     "label": "Show calories",
     "default": false
    },
    {
     "id": "menu.show_allergens",
     "type": "toggle",
     "label": "Show allergens",
     "default": false
    }
   ]
  },
  {
   "group": "Texts",
   "icon": "type",
   "fields": [
    {
     "id": "texts.announcement",
     "type": "text",
     "label": "Announcement",
     "default": "Free shipping over SAR 200 \u00b7 14-day returns"
    },
    {
     "id": "texts.hero_title",
     "type": "text",
     "label": "Hero title",
     "default": "The new edit"
    },
    {
     "id": "texts.hero_subtitle",
     "type": "text",
     "label": "Hero subtitle",
     "default": ""
    },
    {
     "id": "texts.hero_cta",
     "type": "text",
     "label": "Hero button",
     "default": "Shop now"
    },
    {
     "id": "texts.featured_title",
     "type": "text",
     "label": "Featured section title",
     "default": "New in"
    },
    {
     "id": "texts.footer_note",
     "type": "text",
     "label": "Footer note",
     "default": ""
    }
   ]
  },
  {
   "include": "splash",
   "fields": {
    "splash.enabled": {
     "default": false
    }
   }
  },
  {
   "include": "search"
  },
  {
   "include": "share"
  }
 ],
