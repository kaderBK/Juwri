{
  "$schema_note": "Juwri theme tokens v1. Customizer roles (primary, background, surface, text, accent) map 1:1 to colors.* in theme.json; the other colour keys are theme tokens (--x-*) derived in theme.css. Checked by tools/contrast.py (contract §8).",
  "theme": "brew",
  "vertical_set": "food (default for new cafe store type)",
  "default_preset": "matcha",
  "scheme_default": "auto",
  "customizer_roles": [
    "primary",
    "background",
    "surface",
    "text",
    "accent"
  ],
