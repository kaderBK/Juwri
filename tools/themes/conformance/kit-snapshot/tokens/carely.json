  "color_usage": {
    "primary": "CTA fill (add, cart bar, place order), selected strength/pack pill, active category chip, focus ring, links, OTC notice icon",
    "accent": "Badge FILL only (18+ badge uses surface_2, accent is for the single optional campaign badge; label in on-accent). Never body text. Never red: no preset uses red except status danger",
    "surface_2": "OTC notice fill, input fill, 18+ badge, skeletons, quantity select, medicine-facts label column",
    "muted": "meta only (pack line, brand line, VAT note). Dosage, warnings, leaflet link and licence text use `text` (sections/carely.md section 9)",
    "border": "card hairline, dividers (decorative, no contrast requirement)",
    "border_strong": "input + radio + toggle outlines (3:1 non-text)",
    "danger/success/warning": "status text + icons; `warning` is the warnings-block icon and 'Expires soon'. The Rx badge (Tier R, not built) would be inverted `text`, not red"
  },
  "typography": {
    "font_pair": "inter",
    "heading": "Inter 600/800 (Latin) → IBM Plex Sans Arabic 700",
    "body": "Inter (Latin) → IBM Plex Sans Arabic",
    "weights": {
      "body": 400,
      "strong": 600,
      "heading": 800
    },
    "scale_px": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 38,
      "5xl": 48
    },
    "roles": {
      "store_name": {
        "phone": "3xl/heading/700",
        "desktop": "5xl/heading/700"
      },
      "category_title": {
        "phone": "2xl/heading/700",
        "desktop": "3xl/heading/700"
      },
      "item_name": {
        "phone": "lg/body/600",
        "desktop": "lg/body/600"
      },
      "item_desc": {
        "phone": "sm/body/400 muted, 2-line clamp",
        "desktop": "sm/body/400 muted, 2-line clamp"
      },
      "price": {
        "phone": "base/body/600 tabular-nums",
        "desktop": "base/body/600 tabular-nums"
      },
      "sheet_title": {
        "phone": "2xl/heading/700",
        "desktop": "3xl/heading/700"
      },
      "total": {
        "phone": "xl/body/700 tabular-nums",
        "desktop": "xl/body/700 tabular-nums"
      },
      "label": {
        "phone": "sm/body/600",
        "desktop": "sm/body/600"
      },
      "meta": {
        "phone": "xs/body/400 muted (min 12px, never smaller)",
        "desktop": "xs/body/400 muted"
      }
    },
    "line_height": {
      "latin": {
        "tight": 1.15,
        "base": 1.5
      },
      "arabic": {
        "tight": 1.4,
        "base": 1.7
      }
    },
    "rules": [
      "no letter-spacing on Arabic",
      "no uppercase transforms (brand line may use small caps only in Latin)",
      "price + sale price + savings always together",
      "min body 16px on inputs (iOS zoom)",
      "dosage, warnings, leaflet: 16px min on phone, line-height 1.6 (Arabic 1.7), `text` colour, max 70ch, never clamped (sections/carely.md section 9)"
    ]
  },
  "radius": {
    "customizer": "layout.radius",
    "default": "round",
    "values_px": {
      "card": 18,
      "control": 14,
      "chip": 999,
      "sheet_top": 24,
      "image": 12
    }
  },
  "spacing": {
    "customizer": "layout.density",
    "default": "cozy",
    "grid_px": 4,
    "scale_px": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64
    },
    "gutter": {
      "phone": 16,
      "desktop": 32
    },
    "max_content_px": 1200,
    "section_gap": {
      "phone": 32,
      "desktop": 56
    }
  },
  "sizes": {
    "target_primary": 44,
    "target_chip": 32,
    "header_phone": 56,
    "category_bar": 52,
    "cart_bar": 64,
    "item_thumb_list": 96,
    "item_thumb_desktop": 120,
    "icon": 20,
    "icon_small": 16,
    "scroll_padding_note": "scroll-padding-top = header + category_bar; scroll-padding-bottom = cart_bar + 16 (WCAG 2.4.11)",
    "swatch": 32,
    "size_pill_min": 44
  },
  "elevation": {
    "card": "0 1px 2px rgb(0 0 0 / .06)",
    "raised": "0 6px 20px rgb(0 0 0 / .10)",
    "sheet": "0 -8px 32px rgb(0 0 0 / .18)",
    "dark_note": "dark scheme uses surface steps (surface → surface_2) instead of shadows"
  },
  "motion": {
    "fast_ms": 120,
    "base_ms": 200,
    "slow_ms": 320,
    "ease": "cubic-bezier(.2,.8,.2,1)",
    "ease_exit": "cubic-bezier(.4,0,1,1)",
    "patterns": {
      "sheet_open": "translateY(100%)→0, slow, ease",
      "add_to_cart": "button label → check, fast; cart bar count bump scale 1→1.08→1, base",
      "chip_active": "background colour, fast",
      "skeleton": "opacity pulse 1.2s"
    },
    "reduced_motion": "all transforms off; opacity fades ≤ fast only"
  },
  "breakpoints_px": {
    "phone": 0,
    "tablet": 768,
    "desktop": 1080,
    "wide": 1440
  },
  "layout": {
    "card_default": "grid",
    "image_ratio_default": "1:1",
    "category_nav_default": "chips",
    "header_default": "compact",
    "desktop_cart_default": "drawer",
    "order_type_default": "ship",
    "grid": "phone 2 col, desktop 4 col; packshot 1:1 contain on white (not the 4:5 crop)",
    "desktop": "filters sidebar 260 | product rows 4 col; cart is a drawer from the inline end",
    "retail_flow": "strength x pack-size variants with per-variant stock and a per-unit price; medicine facts (dl), warnings, leaflet link, use-by date; server-side quantity limit; age-confirmed lines; pickup slot grid; licence block on every page. Tier R (prescription) is not built (Q1 open)."
  }
}
