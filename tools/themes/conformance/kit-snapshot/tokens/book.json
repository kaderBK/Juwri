{
 "$schema_note": "Juwri theme tokens v1. Customizer roles (primary, background, surface, text, accent) map 1:1 to colors.* in theme.json; the other colour keys are theme tokens (--x-*) derived in theme.css. Checked by tools/contrast.py (contract §8).",
 "theme": "book",
 "vertical_set": "services (new Community `services` store type: salon, barber, spa, clinic visits, repair, cleaning; laundry when the ee module is on)",
 "default_preset": "calm",
 "scheme_default": "auto",
 "customizer_roles": [
  "primary",
  "background",
  "surface",
  "text",
  "accent"
 ],
