{
  "version": 2,
  "texts": {
    "localized": true
  },
  "presets": [
    {
      "id": "clinic",
      "label": "Clinic",
      "thumb": "assets/store_templates/carely/presets/clinic.png",
      "values": {
        "colors.primary": "#146C4B",
        "colors.background": "#FFFFFF",
        "colors.surface": "#FFFFFF",
        "colors.text": "#10231B",
        "colors.accent": "#0E5A8A",
        "colors_dark.primary": "#5FD3A0",
        "colors_dark.background": "#0B1411",
        "colors_dark.surface": "#121E19",
        "colors_dark.text": "#E8F1EC",
        "colors_dark.accent": "#7CC4F2",
        "scheme.mode": "light"
      }
    },
    {
      "id": "calm",
      "label": "Calm",
      "thumb": "assets/store_templates/carely/presets/calm.png",
      "values": {
        "colors.primary": "#1F4E79",
        "colors.background": "#FBFAF7",
        "colors.surface": "#FFFFFF",
        "colors.text": "#1D2430",
        "colors.accent": "#7A3E6B",
        "colors_dark.primary": "#8DB8E8",
        "colors_dark.background": "#10141B",
        "colors_dark.surface": "#181D26",
        "colors_dark.text": "#ECEFF4",
        "colors_dark.accent": "#E3A3D2",
        "scheme.mode": "light",
        "layout.density": "comfortable"
      }
    },
    {
      "id": "mint",
      "label": "Mint",
      "thumb": "assets/store_templates/carely/presets/mint.png",
      "values": {
        "colors.primary": "#0B6B5C",
        "colors.background": "#F6FBF9",
        "colors.surface": "#FFFFFF",
        "colors.text": "#0F2A22",
        "colors.accent": "#A3361F",
        "colors_dark.primary": "#56D1BC",
        "colors_dark.background": "#08110F",
        "colors_dark.surface": "#0F1B18",
        "colors_dark.text": "#E3F2EE",
        "colors_dark.accent": "#FF9B85",
        "scheme.mode": "light",
        "layout.radius": "pill"
      }
    }
  ],
  "settings": [
    {
      "include": "tokens",
      "fields": {
        "colors.primary": {
          "default": "#146C4B"
        },
        "colors.background": {
          "default": "#FFFFFF"
        },
        "colors.surface": {
          "default": "#FFFFFF"
        },
        "colors.text": {
          "default": "#10231B"
        },
        "colors.accent": {
          "default": "#0E5A8A"
        },
        "layout.radius": {
          "default": "round"
        },
        "layout.density": {
          "default": "cozy"
        },
        "fonts.pair": {
          "default": "inter"
        }
      }
    },
    {
      "group": "Appearance",
      "icon": "contrast",
      "fields": [
        {
          "id": "scheme.mode",
          "type": "select",
          "label": "Colour scheme",
          "options": [
            "light",
            "dark",
            "auto"
          ],
          "option_labels": {
            "light": "Light",
            "dark": "Dark",
            "auto": "Follow the device"
          },
          "default": "auto",
          "help": "Auto follows the visitor's phone or computer setting."
        },
        {
          "id": "colors_dark.primary",
          "type": "color",
          "label": "Brand colour (dark)",
          "default": "#5FD3A0",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.background",
          "type": "color",
          "label": "Background (dark)",
          "default": "#0B1411",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.surface",
          "type": "color",
          "label": "Card surface (dark)",
          "default": "#121E19",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.text",
          "type": "color",
          "label": "Text colour (dark)",
          "default": "#E8F1EC",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.accent",
          "type": "color",
          "label": "Accent colour (dark)",
          "default": "#7CC4F2",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        }
      ]
    },
    {
      "group": "Layout",
      "icon": "layout",
      "fields": [
        {
          "id": "layout.card",
          "type": "select",
          "label": "Item card",
          "options": [
            "list",
            "grid",
            "compact"
          ],
          "option_labels": {
            "list": "List",
            "grid": "Grid",
            "compact": "Compact (no image)"
          },
          "default": "grid"
        },
        {
          "id": "layout.image_ratio",
          "type": "select",
          "label": "Image shape",
          "options": [
            "1:1",
            "4:3",
            "16:9",
            "4:5",
            "3:4"
          ],
          "option_labels": {
            "1:1": "Square",
            "4:3": "4:3",
            "16:9": "16:9",
            "4:5": "Portrait 4:5",
            "3:4": "Portrait 3:4"
          },
          "default": "1:1"
        },
        {
          "id": "layout.category_nav",
          "type": "select",
          "label": "Categories",
          "options": [
            "chips",
            "tabs"
          ],
          "option_labels": {
            "chips": "Chips",
            "tabs": "Tabs"
          },
          "default": "chips"
        },
        {
          "id": "layout.header",
          "type": "select",
          "label": "Header",
          "options": [
            "cover",
            "compact"
          ],
          "option_labels": {
            "cover": "Cover image",
            "compact": "Compact"
          },
          "default": "compact"
        },
        {
          "id": "layout.desktop_cart",
          "type": "select",
          "label": "Cart on desktop",
          "options": [
            "panel",
            "drawer"
          ],
          "option_labels": {
            "panel": "Side panel",
            "drawer": "Drawer"
          },
          "default": "drawer"
        }
      ]
    },
    {
      "group": "Content",
      "icon": "list",
      "fields": [
        {
          "id": "menu.show_descriptions",
          "type": "toggle",
          "label": "Show item descriptions",
          "default": true
        },
        {
          "id": "menu.show_calories",
          "type": "toggle",
          "label": "Show calories",
          "default": false
        },
        {
          "id": "menu.show_allergens",
          "type": "toggle",
          "label": "Show allergens",
          "default": false
        }
      ]
    },
    {
      "group": "Texts",
      "icon": "type",
      "fields": [
        {
          "id": "texts.announcement",
          "type": "text",
          "label": "Announcement",
          "default": "Free delivery over SAR 100 · Pick up the same day"
        },
        {
          "id": "texts.hero_title",
          "type": "text",
          "label": "Hero title",
          "default": "Everyday health essentials"
        },
        {
          "id": "texts.hero_subtitle",
          "type": "text",
          "label": "Hero subtitle",
          "default": ""
        },
        {
          "id": "texts.featured_title",
          "type": "text",
          "label": "Featured section title",
          "default": "Everyday essentials"
        },
        {
          "id": "texts.footer_note",
          "type": "text",
          "label": "Footer note",
          "default": ""
        }
      ]
    },
    {
      "include": "splash",
      "fields": {
        "splash.enabled": {
          "default": false
        }
      }
    },
    {
      "include": "search"
    },
    {
      "include": "share"
    }
  ],
  "sections": [
    {
      "id": "header",
      "label": "Header",
      "default": true,
      "toggleable": false,
      "orderable": false
    },
    {
      "id": "announcement",
      "label": "Announcement bar",
      "default": false,
      "toggleable": true,
      "orderable": false
    },
    {
