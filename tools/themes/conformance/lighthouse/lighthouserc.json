{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server -d . 8765",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:8765/prototypes/table/en/home.html",
        "http://localhost:8765/prototypes/table/ar/home.html",
        "http://localhost:8765/prototypes/brew/en/home.html",
        "http://localhost:8765/prototypes/brew/ar/home.html",
        "http://localhost:8765/prototypes/basket/en/home.html",
        "http://localhost:8765/prototypes/basket/ar/home.html",
        "http://localhost:8765/prototypes/aisle/en/home.html",
        "http://localhost:8765/prototypes/aisle/ar/home.html",
        "http://localhost:8765/prototypes/book/en/home.html",
        "http://localhost:8765/prototypes/book/ar/home.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 2.625, "disabled": false },
        "throttlingMethod": "simulate",
        "throttling": { "rttMs": 150, "throughputKbps": 1638.4, "requestLatencyMs": 562.5, "downloadThroughputKbps": 1474.56, "uploadThroughputKbps": 675, "cpuSlowdownMultiplier": 4 },
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }],
        "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
        "interactive": ["warn", { "maxNumericValue": 5000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 92160 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 40960 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 143360 }],
        "resource-summary:font:count": ["error", { "maxNumericValue": 4 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
        "resource-summary:total:count": ["warn", { "maxNumericValue": 40 }],
        "unsized-images": "error",
        "font-display": "error",
        "uses-responsive-images": "warn",
        "modern-image-formats": "warn",
        "offscreen-images": "warn",
        "uses-text-compression": "error",
        "dom-size": ["warn", { "maxNumericValue": 1500 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "is-on-https": "off",
        "uses-http2": "off",
        "redirects-http": "off"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "tools/conformance/lighthouse/.lighthouseci" }
  }
}
