{
  "name": "juwri → Google Sheets: paid orders ledger",
  "description": "When an order is marked paid in juwri, add a row to a Google Sheet.",
  "flow": [
    {
      "id": 1,
      "module": "juwri:watchOrderPaid",
      "version": 1,
      "parameters": {},
      "mapper": {},
      "metadata": { "designer": { "x": 0, "y": 0 } }
    },
    {
      "id": 2,
      "module": "google-sheets:addRow",
      "version": 2,
      "parameters": {},
      "mapper": {
        "0": "{{1.data.order_id}}",
        "1": "{{1.data.total}}",
        "2": "{{1.data.payment_gateway}}",
        "3": "{{1.created_at}}"
      },
      "metadata": { "designer": { "x": 300, "y": 0 } }
    }
  ],
  "metadata": { "instant": true }
}
