{
  "name": "watchOrderPaid",
  "label": "Watch Paid Orders",
  "description": "Triggers when an order is marked paid.",
  "type": "instant_trigger",
  "webhook": "juwriWebhook",
  "event": "order.paid",
  "interface": [
    { "name": "id", "type": "text", "label": "Delivery ID" },
    { "name": "event", "type": "text", "label": "Event" },
    { "name": "created_at", "type": "date", "label": "Delivered at" },
    {
      "name": "data",
      "type": "collection",
      "label": "Order",
      "spec": [
        { "name": "order_id", "type": "number", "label": "Order ID" },
        { "name": "total", "type": "number", "label": "Total" },
        { "name": "payment_gateway", "type": "text", "label": "Payment gateway" }
      ]
    }
  ],
  "samples": {
    "id": "msg_h2K9xW3qLp8RtY5vN0aBcDe7",
    "event": "order.paid",
    "created_at": "2026-07-08T14:03:11+00:00",
    "data": {
      "order_id": 4812,
      "total": 96.5,
      "payment_gateway": "stripe"
    }
  }
}
