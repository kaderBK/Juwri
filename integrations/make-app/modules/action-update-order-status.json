{
  "name": "updateOrderStatus",
  "label": "Update Order Status",
  "description": "Updates the status of an existing order.",
  "type": "action",
  "connection": "juwri",
  "parameters": [
    { "name": "restaurant_id", "type": "integer", "label": "Restaurant ID", "required": true },
    { "name": "order_id", "type": "integer", "label": "Order ID", "required": true },
    {
      "name": "status",
      "type": "select",
      "label": "Status",
      "required": true,
      "options": ["new", "preparing", "ready", "delivered", "completed", "cancelled"]
    }
  ],
  "communication": {
    "url": "{{baseUrl}}/api/v1/stores/{{parameters.restaurant_id}}/orders/{{parameters.order_id}}/status",
    "method": "PUT",
    "body": { "status": "{{parameters.status}}" },
    "response": { "output": "{{body}}" }
  },
  "interface": [
    { "name": "id", "type": "number", "label": "Order ID" },
    { "name": "status", "type": "text", "label": "Status" },
    { "name": "total", "type": "number", "label": "Total" },
    { "name": "currency", "type": "text", "label": "Currency" },
    { "name": "is_paid", "type": "boolean", "label": "Paid" }
  ],
  "samples": {
    "id": 4812,
    "status": "preparing",
    "type": "delivery",
    "total": 96.5,
    "currency": "USD",
    "is_paid": true,
    "created_at": "2026-07-08T14:03:11+00:00"
  }
}
