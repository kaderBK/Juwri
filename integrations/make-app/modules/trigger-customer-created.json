{
  "name": "watchCustomerCreated",
  "label": "Watch New Customers",
  "description": "Triggers when a new customer is created.",
  "type": "instant_trigger",
  "webhook": "juwriWebhook",
  "event": "customer.created",
  "interface": [
    { "name": "id", "type": "text", "label": "Delivery ID" },
    { "name": "event", "type": "text", "label": "Event" },
    { "name": "created_at", "type": "date", "label": "Delivered at" },
    {
      "name": "data",
      "type": "collection",
      "label": "Customer",
      "spec": [
        { "name": "customer_id", "type": "number", "label": "Customer ID" },
        { "name": "name", "type": "text", "label": "Name" }
      ]
    }
  ],
  "samples": {
    "id": "msg_h2K9xW3qLp8RtY5vN0aBcDe7",
    "event": "customer.created",
    "created_at": "2026-07-08T14:03:11+00:00",
    "data": {
      "customer_id": 8841,
      "name": "Jordan Rivera"
    }
  }
}
