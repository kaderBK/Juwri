{
  "name": "updateMenuItem",
  "label": "Update Menu Item",
  "description": "Updates an existing menu item.",
  "type": "action",
  "connection": "juwri",
  "parameters": [
    { "name": "restaurant_id", "type": "integer", "label": "Restaurant ID", "required": true },
    { "name": "item_id", "type": "integer", "label": "Menu Item ID", "required": true },
    { "name": "name", "type": "text", "label": "Name" },
    { "name": "price", "type": "number", "label": "Price" },
    { "name": "category_id", "type": "integer", "label": "Category ID" },
    { "name": "description", "type": "text", "label": "Description" },
    { "name": "active", "type": "boolean", "label": "Active" },
    { "name": "is_sold_out", "type": "boolean", "label": "Sold out" },
    { "name": "calories", "type": "integer", "label": "Calories" }
  ],
  "communication": {
    "url": "{{baseUrl}}/api/v1/stores/{{parameters.restaurant_id}}/menu/items/{{parameters.item_id}}",
    "method": "PUT",
    "body": {
      "name": "{{parameters.name}}",
      "price": "{{parameters.price}}",
      "category_id": "{{parameters.category_id}}",
      "description": "{{parameters.description}}",
      "active": "{{parameters.active}}",
      "is_sold_out": "{{parameters.is_sold_out}}",
      "calories": "{{parameters.calories}}"
    },
    "response": { "output": "{{body}}" }
  },
  "interface": [
    { "name": "id", "type": "number", "label": "Item ID" },
    { "name": "name", "type": "text", "label": "Name" },
    { "name": "price", "type": "number", "label": "Price" },
    { "name": "active", "type": "boolean", "label": "Active" },
    { "name": "is_sold_out", "type": "boolean", "label": "Sold out" }
  ],
  "samples": {
    "id": 991,
    "category_id": 12,
    "name": "Margherita Pizza",
    "price": 13.0,
    "active": true,
    "is_sold_out": false
  }
}
