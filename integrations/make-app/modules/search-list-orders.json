{
  "name": "listOrders",
  "label": "List Orders",
  "description": "Lists orders for a restaurant, newest first, with optional status and date filters.",
  "type": "search",
  "connection": "juwri",
  "parameters": [
    { "name": "restaurant_id", "type": "integer", "label": "Restaurant ID", "required": true },
    { "name": "status", "type": "text", "label": "Status" },
    { "name": "since", "type": "date", "label": "Created since" }
  ],
  "communication": {
    "url": "{{baseUrl}}/api/v1/stores/{{parameters.restaurant_id}}/orders",
    "method": "GET",
    "qs": {
      "status": "{{parameters.status}}",
      "since": "{{parameters.since}}",
      "per_page": 100,
      "page": "{{pagination.page}}"
    },
    "response": {
      "iterate": "{{body.data}}",
      "output": "{{item}}"
    },
    "pagination": {
      "qs": { "page": "{{pagination.page}}" },
      "condition": "{{body.current_page < body.last_page}}"
    }
  },
  "interface": [
    { "name": "id", "type": "number", "label": "Order ID" },
    { "name": "status", "type": "text", "label": "Status" },
    { "name": "type", "type": "text", "label": "Type" },
    { "name": "total", "type": "number", "label": "Total" },
    { "name": "is_paid", "type": "boolean", "label": "Paid" },
    { "name": "customer_name", "type": "text", "label": "Customer" }
  ],
  "samples": {
    "id": 4812,
    "status": "new",
    "type": "delivery",
    "table_number": null,
    "customer_name": "Jane Doe",
    "total": 96.5,
    "is_paid": false,
    "created_at": "2026-07-08T14:03:11+00:00"
  }
}
