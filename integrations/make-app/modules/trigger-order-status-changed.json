{
  "name": "watchOrderStatusChanged",
  "label": "Watch Order Status Changes",
  "description": "Triggers when an order changes status.",
  "type": "instant_trigger",
  "webhook": "juwriWebhook",
  "event": "order.status_changed",
  "interface": [
    { "name": "id", "type": "text", "label": "Delivery ID" },
    { "name": "event", "type": "text", "label": "Event" },
    { "name": "created_at", "type": "date", "label": "Delivered at" },
    {
      "name": "data",
      "type": "collection",
      "label": "Order",
      "spec": [
        { "name": "order_id", "type": "number", "label": "Order ID" },
        { "name": "new_status", "type": "text", "label": "New status" }
      ]
    }
  ],
  "samples": {
    "id": "msg_h2K9xW3qLp8RtY5vN0aBcDe7",
    "event": "order.status_changed",
    "created_at": "2026-07-08T14:03:11+00:00",
    "data": {
      "order_id": 4812,
      "new_status": "preparing"
    }
  }
}
