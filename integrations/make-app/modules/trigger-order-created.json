{
  "name": "watchOrderCreated",
  "label": "Watch New Orders",
  "description": "Triggers when a new order is placed.",
  "type": "instant_trigger",
  "webhook": "juwriWebhook",
  "event": "order.created",
  "interface": [
    { "name": "id", "type": "text", "label": "Delivery ID" },
    { "name": "event", "type": "text", "label": "Event" },
    { "name": "created_at", "type": "date", "label": "Delivered at" },
    {
      "name": "data",
      "type": "collection",
      "label": "Order",
      "spec": [
        { "name": "order_id", "type": "number", "label": "Order ID" },
        { "name": "restaurant_id", "type": "number", "label": "Restaurant ID" },
        { "name": "type", "type": "text", "label": "Type" },
        { "name": "status", "type": "text", "label": "Status" },
        { "name": "total", "type": "number", "label": "Total" },
        { "name": "currency", "type": "text", "label": "Currency" },
        { "name": "track_token", "type": "text", "label": "Track token" },
        { "name": "source", "type": "text", "label": "Source" }
      ]
    }
  ],
  "samples": {
