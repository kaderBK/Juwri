{
  "name": "findOrder",
  "label": "Find Order",
  "description": "Finds an order by its number.",
  "type": "search",
  "connection": "juwri",
  "parameters": [
    { "name": "restaurant_id", "type": "integer", "label": "Restaurant ID", "required": true },
    { "name": "order_id", "type": "integer", "label": "Order number", "required": true }
  ],
  "communication": {
    "url": "{{baseUrl}}/api/v1/stores/{{parameters.restaurant_id}}/orders/{{parameters.order_id}}",
    "method": "GET",
    "response": {
      "iterate": "{{if(body.id; array(body); emptyarray)}}",
      "output": "{{item}}"
    }
  },
  "interface": [
    { "name": "id", "type": "number", "label": "Order ID" },
    { "name": "status", "type": "text", "label": "Status" },
    { "name": "type", "type": "text", "label": "Type" },
    { "name": "total", "type": "number", "label": "Total" },
    { "name": "currency", "type": "text", "label": "Currency" },
    { "name": "is_paid", "type": "boolean", "label": "Paid" }
  ],
  "samples": {
    "id": 4812,
    "status": "preparing",
    "type": "delivery",
    "total": 96.5,
    "currency": "USD",
    "is_paid": true,
    "created_at": "2026-07-08T14:03:11+00:00"
  }
}
