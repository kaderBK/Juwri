{
  "name": "watchRefundCompleted",
  "label": "Watch Completed Refunds",
  "description": "Triggers when a refund is completed.",
  "type": "instant_trigger",
  "webhook": "juwriWebhook",
  "event": "refund.completed",
  "interface": [
    { "name": "id", "type": "text", "label": "Delivery ID" },
    { "name": "event", "type": "text", "label": "Event" },
    { "name": "created_at", "type": "date", "label": "Delivered at" },
    {
      "name": "data",
      "type": "collection",
      "label": "Refund",
      "spec": [
        { "name": "order_id", "type": "number", "label": "Order ID" },
        { "name": "amount", "type": "number", "label": "Amount" },
        { "name": "method", "type": "text", "label": "Method" }
      ]
    }
  ],
  "samples": {
    "id": "msg_h2K9xW3qLp8RtY5vN0aBcDe7",
    "event": "refund.completed",
    "created_at": "2026-07-08T14:03:11+00:00",
    "data": {
      "order_id": 4812,
      "amount": 20,
      "method": "store_credit"
    }
  }
}
