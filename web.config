<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS equivalent of .htaccess: keep core/ sources, secrets and the working
  folders out of reach, then hand every path that is not a real file or
  folder to the front controller (index.php).
-->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <rewrite>
      <rules>
        <rule name="Block core app source" stopProcessing="true">
          <match url="^core/(app|bootstrap|config|database|lang|resources|routes|tests|storage|vendor|node_modules)(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block core sensitive files" stopProcessing="true">
          <match url="^core/(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|server\.php|README\.md)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block integrations and rev" stopProcessing="true">
          <match url="^(rev|integrations/(make-app|n8n-nodes-juwri|zapier-app))(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block root vendor" stopProcessing="true">
          <match url="^vendor(/|$)" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block host check token" stopProcessing="true">
          <match url="^juwri-check\.(token|attempts)$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Host check rewrite probe" stopProcessing="true">
          <match url="^juwri-check-rewrite-probe$" />
          <action type="Rewrite" url="juwri-check.php?juwri_probe=1" appendQueryString="false" />
        </rule>
        <rule name="Front controller" stopProcessing="true">
          <match url="^" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
