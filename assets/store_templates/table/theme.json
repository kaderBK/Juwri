      "values": {
        "colors.primary": "#6D2E8C",
        "colors.background": "#F7F5F9",
        "colors.surface": "#FFFFFF",
        "colors.text": "#1B1722",
        "colors.accent": "#B8862B",
        "colors_dark.primary": "#C79BE0",
        "colors_dark.background": "#14121A",
