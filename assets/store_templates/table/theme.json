        "scheme.mode": "dark",
        "layout.density": "comfortable",
        "layout.card": "compact"
      }
    }
  ],
  "settings": [
    {
      "include": "tokens",
      "fields": {
        "colors.primary": {
          "default": "#B4331A"
        },
        "colors.background": {
          "default": "#FAF6F0"
        },
        "colors.surface": {
          "default": "#FFFFFF"
        },
        "colors.text": {
          "default": "#1F1A17"
        },
        "colors.accent": {
          "default": "#E8A33D"
        },
        "layout.radius": {
          "default": "round"
        },
        "layout.density": {
          "default": "cozy"
        },
        "fonts.pair": {
          "default": "fraunces-jakarta"
        }
      }
    },
    {
      "group": "Appearance",
      "icon": "contrast",
      "fields": [
        {
          "id": "scheme.mode",
          "type": "select",
          "label": "Colour scheme",
          "options": [
            "light",
            "dark",
            "auto"
          ],
          "option_labels": {
            "light": "Light",
            "dark": "Dark",
            "auto": "Follow the device"
          },
          "default": "auto",
          "help": "Auto follows the visitor's phone or computer setting."
        },
        {
          "id": "colors_dark.primary",
          "type": "color",
          "label": "Brand colour (dark)",
          "default": "#F07A52",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.background",
          "type": "color",
          "label": "Background (dark)",
          "default": "#141210",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.surface",
          "type": "color",
          "label": "Card surface (dark)",
          "default": "#1E1B18",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.text",
          "type": "color",
          "label": "Text colour (dark)",
          "default": "#F6F1EA",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        },
        {
          "id": "colors_dark.accent",
          "type": "color",
          "label": "Accent colour (dark)",
          "default": "#F2B65A",
          "visible_if": {
            "scheme.mode": [
              "dark",
              "auto"
            ]
          }
        }
      ]
    },
    {
      "group": "Layout",
      "icon": "layout",
      "fields": [
        {
          "id": "layout.card",
          "type": "select",
          "label": "Item card",
          "options": [
            "list",
            "grid",
            "compact"
          ],
          "option_labels": {
            "list": "List",
            "grid": "Grid",
            "compact": "Compact (no image)"
          },
          "default": "list"
        },
        {
          "id": "layout.image_ratio",
          "type": "select",
          "label": "Image shape",
          "options": [
            "1:1",
            "4:3",
            "16:9",
            "4:5",
            "3:4"
          ],
          "option_labels": {
            "1:1": "Square",
            "4:3": "4:3",
            "16:9": "16:9",
            "4:5": "Portrait 4:5",
            "3:4": "Portrait 3:4"
          },
          "default": "1:1"
        },
        {
          "id": "layout.category_nav",
          "type": "select",
          "label": "Categories",
          "options": [
            "chips",
            "tabs"
          ],
          "option_labels": {
            "chips": "Chips",
            "tabs": "Tabs"
          },
          "default": "chips"
        },
        {
          "id": "layout.header",
          "type": "select",
          "label": "Header",
          "options": [
            "cover",
            "compact"
          ],
          "option_labels": {
            "cover": "Cover image",
            "compact": "Compact"
          },
          "default": "cover"
        },
        {
          "id": "layout.desktop_cart",
          "type": "select",
          "label": "Cart on desktop",
          "options": [
            "panel",
            "drawer"
          ],
          "option_labels": {
            "panel": "Side panel",
            "drawer": "Drawer"
          },
          "default": "panel"
        }
      ]
    },
    {
      "group": "Content",
      "icon": "list",
      "fields": [
        {
          "id": "menu.show_descriptions",
          "type": "toggle",
          "label": "Show item descriptions",
          "default": true
        },
        {
          "id": "menu.show_calories",
          "type": "toggle",
          "label": "Show calories",
          "default": true
        },
        {
          "id": "menu.show_allergens",
          "type": "toggle",
          "label": "Show allergens",
          "default": true
        }
      ]
    },
    {
      "group": "Texts",
      "icon": "type",
      "fields": [
        {
          "id": "texts.hero_title",
          "type": "text",
          "label": "Hero title",
          "default": ""
        },
        {
          "id": "texts.hero_subtitle",
          "type": "text",
          "label": "Hero subtitle",
          "default": ""
        },
        {
          "id": "texts.featured_title",
          "type": "text",
          "label": "Featured section title",
          "default": "Today's specials"
        },
        {
          "id": "texts.footer_note",
          "type": "text",
          "label": "Footer note",
          "default": ""
        }
      ]
    },
    {
      "include": "splash",
      "fields": {
        "splash.enabled": {
          "default": false
        }
      }
    },
    {
      "include": "search"
    },
    {
      "include": "share"
    }
  ],
  "sections": [
