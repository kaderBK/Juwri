  "settings": [
    {
      "include": "tokens",
      "fields": {
        "colors.primary": {
          "default": "#b5d336"
        },
        "colors.background": {
          "default": "#f7f7f5"
        },
        "colors.surface": {
          "default": "#ffffff"
        },
        "colors.text": {
          "default": "#141414"
        },
        "colors.accent": {
          "default": "#e05a4e"
        },
        "layout.radius": {
          "default": "round"
        },
        "layout.density": {
          "default": "cozy"
        }
      }
    },
    {
      "include": "splash",
      "fields": {
        "splash.title": {
          "default": "Fresh food, zero fuss",
          "label": "Splash tagline"
        }
      }
    },
    {
      "include": "search"
    },
    {
      "include": "share"
    },
    {
      "group": "Texts",
      "fields": [
        {
          "id": "texts.follow_label",
          "type": "text",
          "label": "Follow button",
          "default": "Follow"
        }
      ]
    },
    {
      "group": "Brand row",
      "fields": [
        {
          "id": "brand.show_follower_count",
          "type": "toggle",
          "label": "Show follower count",
          "default": true
        },
        {
          "id": "brand.show_cover",
          "type": "toggle",
          "label": "Show cover photo",
          "default": true
        }
      ]
    }
  ],
  "sections": [
    {
      "id": "brand_row",
      "label": "Brand & follow row",
      "toggleable": true,
      "default": true,
      "orderable": false
    }
  ]
}
