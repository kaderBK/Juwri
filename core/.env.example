# Owner mobile app (Capacitor shell) — config/mobile_app.php, rev/mobile-app/
MOBILE_APP_ENABLED=true
MOBILE_APP_ID=com.juwri.owner
MOBILE_APP_MIN_VERSION_IOS=1.0.0
MOBILE_APP_MIN_VERSION_ANDROID=1.0.0
MOBILE_APP_LATEST_VERSION_IOS=1.0.0
MOBILE_APP_LATEST_VERSION_ANDROID=1.0.0
MOBILE_APP_IOS_STORE_URL=
MOBILE_APP_ANDROID_STORE_URL=
MOBILE_APP_TOKEN_TTL_DAYS=180
# Deep links: both .well-known files 404 until these are set.
MOBILE_APP_APPLE_TEAM_ID=
MOBILE_APP_ANDROID_SHA256=

# Owner dashboard redesign (config/owner_ui.php): set false to fall back instantly.
OWNER_UI_SKIN=true
OWNER_UI_MOBILE_TABBAR=true

# Tenancy (config/tenancy.php, P1-04): data-residency regions accounts may use, and the default for new accounts.
TENANCY_REGIONS=global,sa,ae
TENANCY_DEFAULT_REGION=global

# Hosts / origins (P1-20, J28). HOST_MODE=single keeps one host; split separates app/admin/storefront/marketing.
HOST_MODE=single
APP_ADMIN_URL=
STOREFRONT_URL=
MARKETING_URL=
STORE_PRIMARY_REDIRECT=true
DOMAIN_VERIFICATION=txt
DOMAIN_PENDING_GRACE_HOURS=72
# Days an unverified reseller custom-domain request holds its host (then it is stale).
RESELLER_DOMAIN_REQUEST_DAYS=14
# Migrated install only: the source platform's TXT challenge labels and value prefixes, accepted for imported store
# domains (comma lists, e.g. _source-verify and source-verify=). Empty everywhere else.
DOMAIN_LEGACY_VERIFY_LABELS=
DOMAIN_LEGACY_TXT_PREFIXES=
# Days a lapsed custom domain stays reserved for its store before it is released
DOMAIN_RELEASE_AFTER_DAYS=14
APP_SESSION_COOKIE=site_app
ADMIN_SESSION_COOKIE=site_admin
STOREFRONT_SESSION_COOKIE=site_store
MARKETING_SESSION_COOKIE=site_marketing
MARKETING_PRUNE_SUBSCRIBERS=false
ADMIN_SESSION_LIFETIME=30
ADMIN_IP_ALLOWLIST=
TLS_ASK_TOKEN=
CSP_STOREFRONT_ENFORCE=all
# PostgreSQL row-level security on account_id (no-op on MySQL/SQLite); see docs/dev/tenancy-isolation.md
TENANCY_RLS=true
TENANCY_RLS_APP_ROLE=
# Tenant-aware infra (P1-04 slice 7): region => storage disk JSON, e.g. {"sa":"s3_sa"} (empty = caller's disk);
# account-wide owner-API budget per minute across all of an account's tokens
TENANCY_REGION_DISKS=
TENANCY_OWNER_API_ACCOUNT_RATE=600
# account-wide headless storefront API write budget per minute (P3-06b)
TENANCY_STOREFRONT_WRITE_ACCOUNT_RATE=300

# P1-19 passkeys (WebAuthn). Enabled by default. Challenge lifetime in seconds; browser prompt timeout in milliseconds.
# PASSKEYS_ENABLED=true
# PASSKEYS_CHALLENGE_TTL=120
# PASSKEYS_TIMEOUT=60000
# Secret for the opaque user handle stored in passkeys; empty = derived from APP_KEY.
# PASSKEYS_USER_HANDLE_SECRET=

# P1-08b J25-8 fiscal adapters (config/fiscal.php): Jordan JoFotara and Egypt ETA on by default; the UAE Peppol
# PINT AE adapter is a stub, off until an accredited-service-provider connector (ee) is configured.
# KSA ZATCA (RB-11). Live FATOORA calls only with ZATCA_LIVE=true; ZATCA_ENV = sandbox | simulation | production.
# Check readiness any time: php artisan fiscal:zatca-check
# ZATCA_LIVE=false
# ZATCA_ENV=sandbox
# ZATCA_BASE_URL=
# ZATCA_RENEW_WARN_DAYS=45
# Folder of the unpacked ZATCA SDK (Java) used by `php artisan fiscal:zatca-sdk-validate`; empty = not installed.
# ZATCA_SDK_PATH=
# FISCAL_JO_ENABLED=true
# FISCAL_EG_ENABLED=true
# FISCAL_AE_PINT_ENABLED=false

# P1-13 editions (config/editions.php). An edition package (the Enterprise package) is found through Composer and loads
# only when its offline licence verifies (Ed25519; 14 days of grace after expiry; the public key ships with the package).
# Local sites only (APP_ENV=local): point JUWRI_LICENCE_PATH at the development licence.
# Defaults shown.
# JUWRI_LICENCE_PATH=storage/app/licence/juwri.licence

# P1-17 Laravel Pulse operations dashboard for self-hosters (superadmin only at /pulse). Off by default.
# PULSE_ENABLED=false
# PULSE_PATH=pulse
# PULSE_STORAGE_KEEP="7 days"
# Advanced Pulse knobs (defaults shown; leave commented unless you tune them). PULSE_DOMAIN defaults to the admin host.
# PULSE_DOMAIN=
# PULSE_DB_CONNECTION=
# PULSE_CACHE_DRIVER=
# PULSE_INGEST_DRIVER=storage
# PULSE_INGEST_BUFFER=5000
# PULSE_INGEST_KEEP="7 days"
# PULSE_REDIS_CONNECTION=
# PULSE_SLOW_REQUESTS_ENABLED=true
# PULSE_SLOW_REQUESTS_SAMPLE_RATE=1
# PULSE_SLOW_REQUESTS_THRESHOLD=1000
# PULSE_SLOW_QUERIES_ENABLED=true
# PULSE_SLOW_QUERIES_SAMPLE_RATE=1
# PULSE_SLOW_QUERIES_THRESHOLD=1000
# PULSE_SLOW_QUERIES_LOCATION=false
# PULSE_SLOW_QUERIES_MAX_QUERY_LENGTH=2000
# PULSE_EXCEPTIONS_ENABLED=true
# PULSE_EXCEPTIONS_SAMPLE_RATE=1
# PULSE_EXCEPTIONS_LOCATION=true
# PULSE_QUEUES_ENABLED=true
# PULSE_QUEUES_SAMPLE_RATE=0.25
# PULSE_CACHE_INTERACTIONS_ENABLED=true
# PULSE_CACHE_INTERACTIONS_SAMPLE_RATE=0.1

# P1-23 website legal pages (JUWRI LTD's documents for juwri Cloud: /terms, /privacy, /security, /legal/*,
# /.well-known/security.txt, sign-up acceptance records). Keep false on an instance not run by JUWRI LTD.
# Every {{FILL}} value below must be set before publishing: `php artisan legal:check` fails until then and a
# production request never renders a placeholder. {{VERIFY}} promises: set true once confirmed (else soften the text).
# These can also be filled from the admin panel: sign in as the admin and open Settings > Legal & compliance
# (.../settings/legal under your admin URL). Values saved there override the LEGAL_* values below.
LEGAL_PAGES=false
# Production: hide a legal page that still has an unresolved {{FILL}} marker (404, no footer link); false = answer 503.
LEGAL_HIDE_UNFILLED=true
# Effective dates (YYYY-MM-DD) of the 1.1 terms / free-reseller terms; empty = not yet in force (TermsChangeNotice fires when set)
LEGAL_TERMS_1_1_EFFECTIVE=
LEGAL_FREE_RESELLER_1_1_EFFECTIVE=
LEGAL_PGP_FINGERPRINT=
LEGAL_GITHUB_URL=
# Public address of the repository's GitHub private vulnerability reporting page (https://github.com/<owner>/<repo>/security/advisories/new).
# Defaults to the public Community repository; empty = the legal pages say "GitHub private vulnerability reporting on our repository" and security.txt lists only the Security page.
LEGAL_SECURITY_REPORT_URL=https://github.com/kaderBK/Juwri/security/advisories/new
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_REGION=
LEGAL_HOSTING_CERTIFICATIONS=
LEGAL_EGYPT_REPRESENTATIVE=
LEGAL_ICO_NUMBER=
LEGAL_ANALYTICS_TOOL=
LEGAL_HIGHER_PLANS=
LEGAL_WHATSAPP_NUMBER=
LEGAL_SUPPORT_PHONE=
LEGAL_HOLIDAY_CALENDAR_URL=
LEGAL_BACKUP_REGION=
LEGAL_VENDOR_HOSTING=
LEGAL_VENDOR_BACKUP=
LEGAL_VENDOR_CDN=
LEGAL_VENDOR_EMAIL=
LEGAL_VENDOR_MESSAGING=
LEGAL_VENDOR_AI=
LEGAL_VENDOR_MAPS=
LEGAL_VENDOR_MONITORING=
LEGAL_VENDOR_SUPPORT=
LEGAL_VENDOR_ANALYTICS=
LEGAL_VENDOR_PUSH=
LEGAL_VENDOR_LOGGING=
LEGAL_LOCATION_CDN=
LEGAL_LOCATION_EMAIL=
LEGAL_LOCATION_MESSAGING=
LEGAL_LOCATION_AI=
LEGAL_LOCATION_MAPS=
LEGAL_LOCATION_MONITORING=
LEGAL_LOCATION_SUPPORT=
LEGAL_LOCATION_ANALYTICS=
LEGAL_LOCATION_PUSH=
LEGAL_LOCATION_LOGGING=
LEGAL_VERIFY_AI_NO_TRAINING=false
LEGAL_VERIFY_ENCRYPTION_AT_REST=false
LEGAL_VERIFY_AUTH_METHODS=false
LEGAL_VERIFY_BACKUPS=false
LEGAL_SECURITY_TXT_EXPIRES=2027-10-01T00:00:00.000Z
LEGAL_SECURITY_TXT_ENCRYPTION=
LEGAL_SECURITY_TXT_ACKNOWLEDGMENTS=
LEGAL_PGP_KEY_PATH=

# PCI DSS 6.4.3 / 11.6.1 payment-page script controls (config/payment_scripts.php; docs/dev/pci-scripts.md).
# Strict CSP on payment pages: PCI_CSP_ENFORCE=false is report-only, for a short investigation window only.
PCI_CSP_ENABLED=true
PCI_CSP_ENFORCE=true
# Stored CSP violation rows per page and hour, requests per minute per client on the report endpoint, retention.
PCI_CSP_REPORTS_PER_HOUR=200
PCI_CSP_REPORTS_PER_MINUTE=30
PCI_CSP_REPORTS_RETENTION_DAYS=90
# Weekly change detection (pci:check-payment-pages): any cron expression; extra pages as a JSON list of
# {"page": "<key>", "url": "<absolute or /path>"}; probes render the built-in payment views for PCI_PROBE_STORE
# (store slug, empty = the oldest active store); fetch timeout in seconds.
PCI_MONITOR_ENABLED=true
PCI_MONITOR_CRON="30 4 * * 1"
PCI_MONITOR_TARGETS=[]
PCI_MONITOR_PROBES=true
PCI_PROBE_STORE=
PCI_MONITOR_TIMEOUT=20

# juwri-hosted services (config/hosted_services.php). Install side: where the install connects (only after the owner
# runs juwri:services:connect). juwri Cloud side only: issued-licence register, revocations and limit-holds files.
JUWRI_SERVICES_URL=https://services.juwri.com
JUWRI_SERVICES_TIMEOUT=15
JUWRI_REGISTER_PATH=
JUWRI_REVOCATIONS_PATH=
JUWRI_LIMIT_HOLDS_PATH=
JUWRI_HOSTED_REGISTER_PER_HOUR=10
# Install side: set to true to use juwri-hosted AI credits (Ai driver juwri_hosted).
AI_JUWRI_HOSTED=false
# P6-68b: let the PLATFORM-admin AI credential base URL point at a private/LAN host (self-hosted LLM). Default false: vault base URLs must be public https; merchant/reseller URLs always are.
AI_ALLOW_PRIVATE_BASE_URL=false
# juwri Cloud side only: max tokens per hosted AI request; STOP-list hash key (keep it across APP_KEY rotations).
JUWRI_HOSTED_AI_MAX_TOKENS=2000
JUWRI_HOSTED_OPTOUT_KEY=
# Install side: juwri_hosted signs Saudi ZATCA invoices through juwri (keys stay on the juwri side).
FISCAL_SA_SIGNING=
# juwri Cloud side only: App Store download links (signing key, 32+ characters; link lifetime in seconds; package disk).
JUWRI_HOSTED_DOWNLOAD_KEY=
JUWRI_HOSTED_DOWNLOAD_TTL=300
JUWRI_HOSTED_APPSTORE_DISK=local
# Install side: juwri_relay sends the delivery-app partner connectors through the juwri Cloud relay (default direct).
CHANNELS_PARTNER_TRANSPORT=direct
# juwri Cloud side only: the disk holding juwri release packages for the update server.
JUWRI_HOSTED_UPDATES_DISK=local

# P3-12 theme aliases (config/theme-successors.php): old theme slugs render their kit successor. Off until the P3-15
# e2e sweep.
JUWRI_THEME_ALIASES=false

# Octane worker mode (optional; php-fpm / Herd need none of this). Phase 2 item 16.
OCTANE_SERVER=frankenphp
OCTANE_HTTPS=false

# Payment sandboxes: allow provider TEST keys / sandbox mode (staging and demo installs only; never production)
# J51a: Tap and Moyasar are hidden at launch; true shows them again (admin + store settings)
PAYMENTS_SHOW_DEFERRED_GATEWAYS=false
PAYMENTS_SANDBOX_ENABLED=false
# BL-039: PayPal subscriptions created before this ISO-8601 timestamp still accept legacy query-string custom_id
#PAYPAL_LEGACY_CUSTOM_ID_UNTIL=2026-11-16T00:00:00Z
# P6-93 payments:watch health alerts (config/payments.php 'watch'; defaults shown)
#PAYMENTS_WATCH_COOLDOWN_MINUTES=60
#PAYMENTS_WATCH_STUCK_MINUTES=30
#PAYMENTS_WATCH_STUCK_MIN_COUNT=3
#PAYMENTS_WATCH_REJECTIONS_PER_HOUR=20
#PAYMENTS_WATCH_REJECTIONS_PER_HOUR_STORE=5
#PAYMENTS_WATCH_PAYOUT_PENDING_HOURS=72
#PAYMENTS_WATCH_OUTBOX_BACKLOG_MINUTES=15

# Language-prefixed URLs under Octane (auto = register every active locale only inside a worker; off|all|ar,fr for tests)
# JUWRI_LOCALE_ROUTES=auto

# Very large food catalogues (P4-16): above THRESHOLD items a kit storefront draws ITEMS cards and loads the rest in place;
# the catalogue API pages a food menu of more than AUTO_PAGE items
# STOREFRONT_HOME_PAGE_THRESHOLD=200
# STOREFRONT_HOME_PAGE_ITEMS=60
# STOREFRONT_CATALOG_AUTO_PAGE=300

# Offline POS (config/pos.php): offline hours (store default / platform max), unsynced retention days, offline card caps
# in minor units (SAR 250 / 2,500) — offline card stays off until the provider confirms deferred authorisation.
POS_OFFLINE_DEFAULT_HOURS=12
POS_OFFLINE_MAX_HOURS=24
POS_OFFLINE_RETENTION_DAYS=7
POS_OFFLINE_WIPE_AFTER_DAYS=3
POS_OFFLINE_CARD_ENABLED=false
POS_OFFLINE_CARD_MAX_AMOUNT_MINOR=25000
POS_OFFLINE_CARD_MAX_TOTAL_MINOR=250000
POS_OFFLINE_ZATCA_DEVICE_SIGNING=false
POS_OFFLINE_ZATCA_PENDING_WARN_HOURS=12
POS_OFFLINE_ZATCA_UNSEEN_WARN_HOURS=12
POS_OFFLINE_ZATCA_CHAIN_DAYS=7
# Folder for the owner's account-export archives (default storage/app/account-exports)
# ACCOUNT_EXPORTS_PATH=

# Seconds the built catalogue cards of a storefront are kept (default 60; 0 = off). Menu edits show at once; see config/perf.php
# STOREFRONT_CATALOG_CACHE_TTL=60

# Seconds the owner's per-store full-page cache trial keeps the anonymous home page (default 300)
# STOREFRONT_FULLPAGE_CACHE_TRIAL_TTL=300

# Folder for the Reserve-with-Google feed files (default storage/app/rwg); tests give each process its own
# RWG_FEEDS_PATH=

# P5-17 owner-app in-app billing (off until real keys exist)
INAPP_APPLE_ENABLED=false
INAPP_APPLE_BUNDLE_ID=
INAPP_APPLE_ENVIRONMENTS=Production
INAPP_APPLE_ROOT_SHA256=
INAPP_GOOGLE_ENABLED=false
INAPP_GOOGLE_PACKAGE=
INAPP_GOOGLE_SERVICE_ACCOUNT_JSON=
INAPP_GOOGLE_PUSH_AUDIENCE=
INAPP_GOOGLE_PUSH_SERVICE_ACCOUNT=

# P5-21 KSA SoftPOS adapters (off until partner onboarding; offline card stays off until OP-0)
SOFTPOS_GEIDEA_ENABLED=false
SOFTPOS_GEIDEA_BASE_URL=https://api.ksamerchant.geidea.net
SOFTPOS_GEIDEA_OFFLINE=false
SOFTPOS_EDFAPAY_ENABLED=false
SOFTPOS_EDFAPAY_BASE_URL=https://api.edfapay.com
SOFTPOS_EDFAPAY_OFFLINE=false

# Phone agent (voice) - Cloud only. Empty = derived from APP_URL / APP_KEY.
VOICE_BRIDGE_ENABLED=false
# public wss origin the carrier connects callers to
VOICE_BRIDGE_PUBLIC_URL=
# signs the short-lived per-call bridge token (empty = key derived from APP_KEY)
VOICE_BRIDGE_SECRET=
# Telnyx account public key (base64 Ed25519) used to verify webhook signatures
TELNYX_PUBLIC_KEY=
# optional tuning (defaults are fine)
# VOICE_BRIDGE_MAX_CONCURRENT_CALLS=3
# VOICE_BRIDGE_PROBE_TIMEOUT=1.5
# VOICE_BRIDGE_REVERB_HOST=
# VOICE_BRIDGE_REVERB_PORT=
# VOICE_MAX_CALL_MINUTES=8
# VOICE_MAX_TURNS=20
# VOICE_MAX_CONCURRENT=3
# VOICE_STORE_MONTHLY_MINUTES=600
# VOICE_PLAN_PRICE=149
# VOICE_RECORDINGS_DISK=local
# VOICE_PLAN_INCLUDED_MINUTES=600
# VOICE_OVERAGE_PER_MINUTE=0.20
# VOICE_COST_PER_MINUTE=0.12
# VOICE_COST_CURRENCY=USD
# VOICE_REQUIRE_PAY_LINK=true
# VOICE_PAY_LINK_MINUTES=30
# VOICE_BUDGET_FAILED_RATE=0.05
# VOICE_BUDGET_MIN_CALLS=20
# VOICE_BUDGET_HANDOFF_FAILURES=0
# VOICE_BUDGET_SIGNATURE_REJECTS=10
# VOICE_BUDGET_CALLBACK_ERRORS=5
# VOICE_BUDGET_LATENCY_P95_MS=3000

# P6-114: optional public status page (any provider, http/https). Empty = no "System status" link in the footer.
STATUS_PAGE_URL=

# P6-248: the ONE indexing switch. robots.txt allows crawlers (and names this host's sitemap) only when APP_ENV=production
# AND SEO_NOINDEX=false; any other APP_ENV, or SEO_NOINDEX=true, gets Disallow: / plus X-Robots-Tag: noindex.
# Keep a staging / migrated-copy install noindex; the production install flips it on at cut-over (APP_ENV=production, SEO_NOINDEX=false).
SEO_NOINDEX=false

# P6-254: SMS / checkout-OTP abuse caps (config/abuse.php; defaults shown)
ABUSE_STORE_CAP_SMS_PLATFORM=50
ABUSE_STORE_IP_CAP_SMS_PLATFORM=10
ABUSE_GLOBAL_CAP_SMS=20000
ABUSE_CHECKOUT_OTP_PHONE_DAILY=15

# P6-249: bounce / complaint webhooks (POST /webhook/mail/{provider}); blank = that provider's webhook is refused (deploy/EMAIL.md)
SES_SNS_TOPIC_ARN=
MAILGUN_WEBHOOK_SIGNING_KEY=
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASSWORD=
SENDGRID_WEBHOOK_PUBLIC_KEY=

# J52b: LegacyCompat switch, OFF by default; only the old-platform data migration install sets true (LEGACYCOMPAT-SPEC)
LEGACY_COMPAT_ENABLED=false
# J52b LegacyCompat (read only when LEGACY_COMPAT_ENABLED=true), set at cut-over, never committed with values:
# old printed-QR passphrases, comma-separated; room-token old app key(s), each encrypted with this install's APP_KEY
# (php artisan tinker: Crypt::encryptString('<old key>')), comma-separated; the end of the old-key grace period (J56,
# absolute Y-m-d or ISO-8601, required at cut-over, empty = old-key room tokens refused).
LEGACY_COMPAT_QR_PASSPHRASES=
LEGACY_COMPAT_ROOM_TOKEN_KEYS=
LEGACY_COMPAT_ROOM_KEY_UNTIL=
# The old platform's own host(s), comma-separated (plan Q13): served like the storefront host while the module is on;
# empty = none. Run `php artisan legacy:slug-conflicts` + route:cache after changing it.
LEGACY_COMPAT_HOSTS=
# Google Wallet passes saved on phones before the migration (plan Q11): the source issuer id and the highest imported
# store id; empty issuer or 0 = off (platform ids). Prefixes/separator = the source id shape.
LEGACY_COMPAT_WALLET_ISSUER_ID=
LEGACY_COMPAT_WALLET_MAX_STORE_ID=0
LEGACY_COMPAT_WALLET_LOYALTY_PREFIX=loy
LEGACY_COMPAT_WALLET_GIFT_CARD_PREFIX=gc
LEGACY_COMPAT_WALLET_OBJECT_SEPARATOR=c
# SEO parity of the migrated install (set at cut-over; empty = no change). `php artisan legacy:seo-locales` applies the
# language set (the root language, the languages served, prefix mode) to the platform settings; `--check` only reports.
# Example: LEGACY_COMPAT_SEO_LOCALE_DEFAULT=ar, LEGACY_COMPAT_SEO_LOCALES=ar,en,fr,de,es,zh,ru,hi,tr,ur,pt
LEGACY_COMPAT_SEO_LOCALE_DEFAULT=
LEGACY_COMPAT_SEO_LOCALES=
LEGACY_COMPAT_SEO_LOCALE_PREFIX=true
# Contact and one comparison page keep the old site's titles.
LEGACY_COMPAT_SEO_TITLE_PARITY=true
# 301 www.<APP_URL host> and plain http to https://<APP_URL host> (app host only; true on production once TLS is live).
LEGACY_COMPAT_SEO_CANONICAL_REDIRECT=false
# One-off old-platform import (php artisan legacy:import), migration host only, set at cut-over, never committed with
# values: switch, source connection (no default host), source server time zone (required, plan Q4), source app key
# (decrypts per-store gateway secrets for re-encryption; empty = encrypted secrets not imported), gateways allowed to
# stay on (J51a), read chunk size, id sequence gap.
# J62 hard gate: true only after the owner signed off the demo, the feature parity matrix and the SEO parity report.
LEGACY_CUTOVER_OWNER_SIGNOFF=false
LEGACY_IMPORT_ENABLED=false
# Fresh-install hosts that must never receive migrated data (J60): the import refuses when the target install's own
# host (the host of APP_URL) is one of them or a sub-domain of one. The built-in host stays forbidden even when this
# list is emptied.
LEGACY_IMPORT_FORBIDDEN_TARGET_HOSTS=juwri.com
# J60: REQUIRED at cut-over. The host this install serves; must equal the host of APP_URL and not be a forbidden host.
LEGACY_IMPORT_TARGET_HOST=
LEGACY_IMPORT_DB_DRIVER=mysql
LEGACY_IMPORT_DB_HOST=
LEGACY_IMPORT_DB_PORT=
LEGACY_IMPORT_DB_DATABASE=
LEGACY_IMPORT_DB_USERNAME=
LEGACY_IMPORT_DB_PASSWORD=
LEGACY_IMPORT_DB_CHARSET=utf8mb4
LEGACY_IMPORT_DB_COLLATION=utf8mb4_unicode_ci
LEGACY_IMPORT_DB_PREFIX=
LEGACY_IMPORT_SOURCE_TIMEZONE=
LEGACY_IMPORT_SOURCE_APP_KEY=
LEGACY_IMPORT_SOURCE_CIPHER=AES-256-CBC
LEGACY_IMPORT_ENABLED_GATEWAYS=stripe,paypal
LEGACY_IMPORT_PLAN_MAP=
LEGACY_IMPORT_DOMAIN_GRACE_HOURS=2160
LEGACY_IMPORT_CHUNK=500
LEGACY_IMPORT_SEQUENCE_GAP=1000
# Old media copy (legacy:media-copy / media-verify / media-index, plan Q6): source and target disk names from
# config/filesystems.php and the manifest's absolute local path; empty = nothing read or written, old media links 404.
LEGACY_COMPAT_MEDIA_FROM_DISK=
LEGACY_COMPAT_MEDIA_TO_DISK=
LEGACY_COMPAT_MEDIA_MANIFEST=
# QR table/room key lookups: unknown keys allowed per store per minute, per visitor session and per client network
# (TableKeyGuard); seconds between two counted QR scans per client network and store (ScanDedupe).
ABUSE_TABLE_KEY_MISSES_PER_MINUTE=20
ABUSE_TABLE_KEY_MISSES_PER_MINUTE_NETWORK=100
ABUSE_SCAN_DEDUPE_SECONDS=30
