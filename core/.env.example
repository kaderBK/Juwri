# ALERT_MAX_THEME_RENDER_FAILS=
# C2: absolute paths to the MySQL client binaries when they are not on PATH
# (cPanel/shared hosting often needs these). Empty = resolve through PATH.
MYSQLDUMP_PATH=
MYSQL_PATH=
# Same for the PostgreSQL client binaries (pg_dump / psql).
PG_DUMP_PATH=
PSQL_PATH=
# C2: suffix for the throwaway schema the restore drill loads into.
# BACKUP_RESTORE_CHECK_SUFFIX=_restore_check
# P1-23: days the platform DB dumps (local and off-box) are kept, and the S3
# server-side encryption asked for on off-box backup objects (empty = none).
# BACKUP_KEEP_DAYS=30
# BACKUP_S3_SSE=AES256
# P6-96: encrypt DB dumps (base64 of 32 bytes; php artisan backup:generate-key). Required on Cloud. Keep a copy off the server.
# BACKUP_ENCRYPTION_KEY=
# Rotated keys still needed to restore older dumps (comma-separated).
# BACKUP_ENCRYPTION_PREVIOUS_KEYS=
# P1-23: breach-notice deadlines (hours from confirmation) and the copy address (juwri Cloud: security@juwri.com).
# BREACH_NOTICE_BCC=
# BREACH_NOTICE_HOURS=48
# BREACH_NOTICE_HOURS_KUWAIT=24
# P1-23 (AUP 3.1): pharmacy selling per country — empty = no country (owner: off until the owner enables it).
# PHARMACY_ENABLED_COUNTRIES=
# PHARMACY_LICENCE_DISK=local
# PHARMACY_LICENCE_MAX_KB=8192
# PHARMACY_MARKETS={}
# PHARMACY_BLOCK_MEDICINE_PROMOTIONS=false  # markets not listed; SA blocks by default (config/pharmacy.php)
# PHARMACY_QUANTITY_CAP=2
# M7: nightly off-box media mirror (platform:media-backup). Empty media root =
# public_path('storage'). Enable per-tenant via Settings → General.
PLATFORM_MEDIA_ROOT=
PLATFORM_MEDIA_PREFIX=backups/platform/media
PLATFORM_MEDIA_MAX_FILES=20000
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=
# ANTHROPIC_VERSION=
# ANTHROPIC_NO_TRAINING=
# API docs (dedoc/scramble, api/v1 only): served in the local env; elsewhere closed unless API_DOCS_PUBLIC=true (owner decision)
# API_DOCS_PUBLIC=false
# API_VERSION=
# SCRAMBLE_DEV_TOOLS=
# API_OWNER_RATE=
# Odoo connector (P4-21): stores connect to a public https Odoo. Self-hosted only: an Odoo on your own LAN, listed exactly
# (host names and/or IPs, comma separated, no wildcards or ranges; plain http allowed for these). Never set this on a
# multi-tenant install: every store owner could then reach the listed hosts.
# ODOO_PRIVATE_HOSTS=odoo.lan,10.0.0.5
# API_RESELLER_RATE=
# API_STOREFRONT_RATE=
# per-IP ceiling of the whole /api/v1 group, requests a minute (default 60; raise it behind one proxy IP or for a load test)
# API_IP_RATE=60
# Headless storefront API writes (quote, orders, customer OTP) per token per minute (P3-06b)
# API_STOREFRONT_WRITE_RATE=30
# Sunset HTTP-date on the deprecated storefront API aliases (launch + 12 months, API-4)
# API_STOREFRONT_LEGACY_SUNSET="Sun, 03 Oct 2027 00:00:00 GMT"
