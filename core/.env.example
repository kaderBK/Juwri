APP_NAME=juwri
# PRODUCTION checklist: APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning,
# APP_URL=https://your-domain, and set CORS_ALLOWED_ORIGINS to your known clients.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# P6-123 hosting profile: shared (cPanel, no root) | cpanel-vps (cPanel/WHM + root) | docker (default when unset).
# It only sets DEFAULTS; any key set explicitly below (QUEUE_CONNECTION, CACHE_DRIVER, SESSION_DRIVER,
# BROADCAST_CONNECTION, BACKUP_DUMP_ENGINE, ...) still wins. Defaults per profile:
#   shared:     queue database (cron drain), heavy cap 600 s, file cache/session, broadcasting off, backups php, no Redis
#   cpanel-vps: queue database (supervisor/systemd workers), heavy cap 1800 s, file cache/session, broadcasting off, backups auto, Redis optional
#   docker:     queue sync, worker containers, heavy cap 1800 s, file cache/session, broadcasting off, backups auto
# Check the host with: php artisan juwri:preflight --profile=shared
#
# --- Shared hosting block (HOSTING_PROFILE=shared; see deploy/HOSTING.md section 2) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain
# HOSTING_PROFILE=shared
# QUEUE_CONNECTION=database   # cron drains it; supervisor and Redis are for cpanel-vps/docker only
# CACHE_DRIVER=file
# SESSION_DRIVER=file
# OCTANE_SERVER is ignored on shared hosting (no Octane); VOICE_BRIDGE_ENABLED=0 (not available)
# BROADCAST_CONNECTION=null   # screens poll; no Reverb
# BACKUP_DUMP_ENGINE=php
# MAIL_*: use the host's own SMTP (outbound 25/587 is often blocked) and a MAIL_FROM_ADDRESS on your domain; see deploy/EMAIL.md
# Do not run `php artisan storage:link` on shared hosting.
# HOSTING_PROFILE=docker
# Base URL of the hosting guide that the admin Hosting health card links to (default /deploy/HOSTING.md).
# HOSTING_DOCS_URL=/deploy/HOSTING.md
# Worker mode reported by preflight: cron | supervisor | container (profile default).
# QUEUE_WORKER_MODE=
# Time cap (seconds) for the cron drain of the heavy queue; kept 60 s under QUEUE_HEAVY_RETRY_AFTER (1860).
# QUEUE_HEAVY_MAX_TIME=
# Time cap (seconds) for the cron drain of the default queue (profile default: shared 45, others 50); kept 30 s under QUEUE_RETRY_AFTER (150).
# QUEUE_DEFAULT_MAX_TIME=
# Scheduler mode: cron | container (profile default).
# SCHEDULER_MODE=
# Backup dump engine: auto | php (PHP-only, no proc_open/mysqldump) | native (profile default; shared = php).
# BACKUP_DUMP_ENGINE=

# Shared secret for the /cronjob scheduler trigger (last resort; prefer the CLI cron).
# Empty => /cronjob 404s. Send it as a header, never in the URL:
#   curl -fsS -H "X-Juwri-Cron-Token: <CRON_TOKEN>" https://YOUR-DOMAIN/cronjob
# CRON_ALLOW_QUERY_TOKEN=true re-enables the deprecated ?token= form (logs a warning).
# CRON_MAX_SECONDS caps one HTTP run (default 50).
# CRON_MAX_SECONDS=50
CRON_TOKEN=

# Owner theme name (only "juwri" ships; the old value "lamar" is read as "juwri").
THEME_NAME=juwri

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
# O12a: leave unset in production to default to `warning` (dev defaults to `debug`).
LOG_LEVEL=debug
# O12c: slow-query threshold in ms; a slower query logs a [slow-query] warning (mysql only). 0 disables.
SLOW_QUERY_LOG_MS=500

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# Live updates (orders list, KDS, POS) over Laravel Reverb. OFF by default: "log" or "null" sends nothing and the
# screens keep polling. Set BROADCAST_CONNECTION=reverb and fill the REVERB_* keys below to switch it on (see
# docker/ for the reverb service). If the socket is unreachable the screens quietly fall back to polling.
BROADCAST_CONNECTION=log
# pre-Laravel-11 name of the same setting; still honoured as a fallback
# BROADCAST_DRIVER=
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# where the app publishes events to (server side) ...
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# ... where the Reverb process listens ...
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# ... and what the browser connects to (your public wss endpoint; empty = same as REVERB_HOST/PORT/SCHEME).
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=
# optional tuning (Reverb defaults are fine): which server block, URL path, limits, allowed browser origins (default: APP_URL host)
# REVERB_SERVER=reverb
# REVERB_SERVER_PATH=
# REVERB_MAX_REQUEST_SIZE=10000
# REVERB_PULSE_INGEST_INTERVAL=15
# REVERB_TELESCOPE_INGEST_INTERVAL=15
# REVERB_ALLOWED_ORIGINS=
# REVERB_APP_PING_INTERVAL=60
# REVERB_APP_ACTIVITY_TIMEOUT=30
# REVERB_APP_MAX_CONNECTIONS=
# REVERB_APP_MAX_MESSAGE_SIZE=10000
# P7: dev/test default is `file` (zero external dependency). In PRODUCTION set
# CACHE_DRIVER=redis and SESSION_DRIVER=redis (REDIS_* below) — every rate-limit
# check and anonymous QR session otherwise does locked file I/O per request.
# See deploy/PROD-HARDENING-CHECKLIST.md § "Cache + session driver".
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# P7: on cpanel-vps/docker prod recommends QUEUE_CONNECTION=redis too (pairs with the supervisor worker). Shared hosting: database.
QUEUE_CONNECTION=database
# P6-64b: default connection retry_after (short jobs, max timeout 120 s) and the `heavy` long-job connection (jobs up to 1800 s).
# QUEUE_RETRY_AFTER=150
# QUEUE_HEAVY_RETRY_AFTER=1860
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_BLOCK=true
# SESSION_BLOCK_STORE=
# SESSION_BLOCK_LOCK_SECONDS=10
# SESSION_BLOCK_WAIT_SECONDS=10

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Sentry error reporting (O2) — blank = disabled
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ─────────────────────────────────────────────────────────────────────────
# O11: every remaining env() key referenced in core/config/*.php, documented
# here so a fresh box does not silently fall back to defaults. Secrets are
# left blank; guarded by tests/Feature/EnvExampleDriftTest.php.
# ─────────────────────────────────────────────────────────────────────────
