{%- comment -%}
  Catering call-to-action (library v1): heading + text around the platform
  catering request widget. The widget gates itself on features.catering;
  the section is only written when it rendered.
{%- endcomment -%}
{%- capture request -%}{%- if features.catering -%}{%- widget 'catering' -%}{%- endif -%}{%- endcapture -%}
{%- liquid
  assign request = request | strip
  assign heading = section.settings.heading | strip
  assign text = section.settings.text | strip
-%}
{%- if request != '' -%}
<section class="mbs-catering-cta" aria-labelledby="mbs-catering-cta-{{ section.id | escape }}">
  <div class="mbs-catering-cta__card">
    <h2 class="mbs-catering-cta__title" id="mbs-catering-cta-{{ section.id | escape }}">{%- if heading != '' -%}{{ heading | escape }}{%- else -%}{{ 'Catering for your event' | t }}{%- endif -%}</h2>
    {%- if text != '' -%}<p class="mbs-catering-cta__text">{{ text | escape | newline_to_br }}</p>{%- endif -%}
    <div class="mbs-catering-cta__actions">{{ request }}</div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Catering",
  "group": "action",
  "verticals": ["food"],
  "max_per_page": 1,
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading (blank = Catering for your event)", "default": "" },
    { "id": "text", "type": "textarea", "label": "Text", "default": "" }
  ],
  "presets": [{ "name": "Catering" }]
}
{% endschema %}
