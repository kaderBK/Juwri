{%- comment -%}
  Branch picker (library v1): heading + text around the platform branch
  switcher widget (plain ?branch_id links; per-branch prices and
  availability). The widget renders nothing unless the store has more than
  one active branch, and then neither does this section.
{%- endcomment -%}
{%- capture picker -%}{%- widget 'branch-switcher' -%}{%- endcapture -%}
{%- liquid
  assign picker = picker | strip
  assign heading = section.settings.heading | strip
  assign text = section.settings.text | strip
-%}
{%- if picker != '' -%}
<section class="mbs-branch-picker" aria-labelledby="mbs-branch-picker-{{ section.id | escape }}">
  {%- render 'icon', name: 'pin', size: 22 -%}
  <div class="mbs-branch-picker__text">
    <h2 class="mbs-branch-picker__title" id="mbs-branch-picker-{{ section.id | escape }}">{%- if heading != '' -%}{{ heading | escape }}{%- else -%}{{ 'Choose your branch' | t }}{%- endif -%}</h2>
    {%- if text != '' -%}<p class="mbs-branch-picker__sub">{{ text | escape }}</p>{%- endif -%}
  </div>
  <div class="mbs-branch-picker__actions">{{ picker }}</div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Branch picker",
  "group": "action",
  "verticals": ["all"],
  "max_per_page": 1,
  "settings": [
    { "id": "heading", "type": "text", "label": "Heading (blank = Choose your branch)", "default": "" },
    { "id": "text", "type": "text", "label": "Text", "default": "" }
  ],
  "presets": [{ "name": "Branch picker" }]
}
{% endschema %}
