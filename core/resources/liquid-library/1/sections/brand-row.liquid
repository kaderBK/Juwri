{%- comment -%}
  Brand row (library v1): logo, name, tagline, the store's average item
  rating (only when reviews exist), open status from `hours`, and quick
  contact links (follow / WhatsApp / call) when the store has them, plus a
  Share button (commerce runtime v2 `data-mb-share`: native share sheet or
  copy-link). It ships `hidden` and the runtime reveals it, so it never shows
  as a dead button on a page without the v2 runtime.
{%- endcomment -%}
{%- liquid
  assign r_total = 0.0
  assign r_count = 0
  if section.settings.show_rating
    for it in menu.items
      if it.rating_count > 0
        assign weighted = it.rating | times: it.rating_count
        assign r_total = r_total | plus: weighted
        assign r_count = r_count | plus: it.rating_count
      endif
    endfor
  endif
-%}
<section class="mbs-brand-row" aria-label="{{ restaurant.title | escape }}">
  {%- if restaurant.logo -%}
    {%- assign logo_url = restaurant.logo | media_url: 'logo' -%}
    {%- render 'media', src: logo_url, alt: restaurant.title, width: 72, height: 72, class: 'mbs-brand-row__logo', priority: false, sizes: '' -%}
  {%- endif -%}
  <div class="mbs-brand-row__id">
    <h2 class="mbs-brand-row__name">{{ restaurant.title | escape }}</h2>
    {%- if section.settings.show_tagline and restaurant.sub_title -%}<p class="mbs-brand-row__tagline">{{ restaurant.sub_title | escape }}</p>{%- endif -%}
    <div class="mbs-brand-row__meta">
      {%- if r_count > 0 -%}
        {%- assign avg = r_total | divided_by: r_count | round: 1 -%}
        <span class="mbs-brand-row__rating" aria-label="{{ 'Rating' | t }}: {{ avg }} / 5">{%- render 'icon', name: 'star', size: 14 -%}<b>{{ avg }}</b><span class="mbs-brand-row__count">(<bdi>{{ r_count }}</bdi>)</span></span>
      {%- endif -%}
      {%- if section.settings.show_status -%}{%- render 'open-badge', hours: hours, detail: true -%}{%- endif -%}
    </div>
  </div>
  {%- if section.settings.show_contact or section.settings.show_share -%}
  <ul class="mbs-brand-row__links" role="list">
    {%- if section.settings.show_contact -%}
    {%- if social.instagram_url -%}<li><a class="mbs-brand-row__link" href="{{ social.instagram_url | escape }}" rel="noopener" target="_blank">{%- render 'icon', name: 'instagram', size: 18 -%}<span>{{ 'Follow Us' | t }}</span></a></li>{%- endif -%}
    {%- if social.whatsapp_url -%}<li><a class="mbs-brand-row__link" href="{{ social.whatsapp_url | escape }}" rel="noopener" target="_blank">{%- render 'icon', name: 'whatsapp', size: 18 -%}<span>{{ 'WhatsApp' | t }}</span></a></li>{%- endif -%}
    {%- if social.phone -%}<li><a class="mbs-brand-row__link" href="tel:{{ social.phone | remove: ' ' | escape }}">{%- render 'icon', name: 'phone', size: 18 -%}<span>{{ 'Call' | t }}</span></a></li>{%- endif -%}
    {%- endif -%}
    {%- if section.settings.show_share -%}<li><button type="button" class="mbs-brand-row__link mbs-brand-row__share" data-mb-share data-mb-share-title="{{ restaurant.title | escape }}" hidden><svg class="mbs-brand-row__share-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13"/></svg><span>{{ 'Share' | t }}</span></button></li>{%- endif -%}
  </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brand row",
  "group": "hero",
  "verticals": ["all"],
  "max_per_page": 1,
  "settings": [
    { "id": "show_tagline", "type": "checkbox", "label": "Show tagline", "default": true },
    { "id": "show_rating", "type": "checkbox", "label": "Show average rating (when reviewed)", "default": true },
    { "id": "show_status", "type": "checkbox", "label": "Show open / closed", "default": true },
    { "id": "show_contact", "type": "checkbox", "label": "Show follow / WhatsApp / call", "default": true },
    { "id": "show_share", "type": "checkbox", "label": "Show share button", "default": true }
  ],
  "presets": [{ "name": "Brand row" }]
}
{% endschema %}
