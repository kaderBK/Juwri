{%- comment -%}
  Banners slider (library v1): the store's promotional banners (`banners`)
  as a scroll-snapping carousel. With autoplay on, the commerce runtime
  advances it (data-mb-slider; pauses on hover / focus, off under
  prefers-reduced-motion) — no theme JS. A banner with a safe link (https, http, /path, #anchor) is a link.
  Aspect: wide 21:9, standard 16:9 or strip 3:1. The first slide may load
  eagerly (on by default: banners usually sit near the top). Hidden when
  the store has no banners.
{%- endcomment -%}
{%- assign banner_count = banners | size -%}
{%- if banner_count > 0 -%}
{%- liquid
  assign aspect = section.settings.aspect
  assign img_h = 675
  if aspect == 'wide'
    assign img_h = 514
  elsif aspect == 'strip'
    assign img_h = 400
  endif
  assign interval = section.settings.interval | plus: 0 | at_least: 3 | at_most: 10 | times: 1000
-%}
<section class="mbs-banners-slider mbs-banners-slider--{{ aspect | escape }}" aria-roledescription="carousel" aria-label="{{ 'Promotions' | t }}">
  <ul class="mbs-banners-slider__track" role="list"{% if section.settings.autoplay and banner_count > 1 %} data-mb-slider data-mb-slider-interval="{{ interval }}"{% endif %}>
    {%- for banner in banners -%}
      {%- liquid
        assign eager = false
        if section.settings.eager_first and forloop.first
          assign eager = true
        endif
        assign link = banner.link_url | strip
        assign l7 = link | slice: 0, 7 | downcase
        assign l8 = link | slice: 0, 8 | downcase
        assign c1 = link | slice: 0, 1
        assign c2 = link | slice: 1, 1
        if l8 == 'https://' or l7 == 'http://'
        elsif c1 == '/' and c2 != '/'
        elsif c1 == '#' and link.size > 1
        else
          assign link = ''
        endif
        assign alt = banner.title | strip
        assign slide_label = 'Slide {n} of {total}' | t | replace: '{n}', forloop.index | replace: '{total}', banner_count
      -%}
      <li class="mbs-banners-slider__slide" aria-roledescription="slide" aria-label="{{ slide_label | escape }}">
        {%- if link != '' -%}<a class="mbs-banners-slider__card" href="{{ link | escape }}">{%- else -%}<div class="mbs-banners-slider__card">{%- endif -%}
          {%- if banner.image_url -%}
            {%- render 'media', src: banner.image_url, alt: alt, width: 1200, height: img_h, class: 'mbs-banners-slider__img', priority: eager, sizes: '(min-width: 1200px) 1200px, 100vw' -%}
          {%- endif -%}
          {%- if section.settings.show_text and banner.title -%}
          <span class="mbs-banners-slider__text">
            <b class="mbs-banners-slider__title">{{ banner.title | escape }}</b>
            {%- if banner.subtitle -%}<span class="mbs-banners-slider__sub">{{ banner.subtitle | escape }}</span>{%- endif -%}
          </span>
          {%- endif -%}
        {%- if link != '' -%}</a>{%- else -%}</div>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Banners slider",
  "group": "engage",
  "verticals": ["all"],
  "max_per_page": 1,
  "settings": [
    { "id": "aspect", "type": "select", "label": "Shape", "options": [
      { "value": "wide", "label": "Wide (21:9)" },
      { "value": "standard", "label": "Standard (16:9)" },
      { "value": "strip", "label": "Strip (3:1)" }
    ], "default": "standard" },
    { "id": "autoplay", "type": "checkbox", "label": "Advance automatically", "default": true },
    { "id": "interval", "type": "range", "label": "Seconds per banner", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 },
    { "id": "show_text", "type": "checkbox", "label": "Show banner title and subtitle", "default": true },
    { "id": "eager_first", "type": "checkbox", "label": "Load the first image immediately (section near the top)", "default": true }
  ],
  "presets": [{ "name": "Banners slider" }]
}
{% endschema %}
