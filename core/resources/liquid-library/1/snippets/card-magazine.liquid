{%- comment -%}
  Magazine card (library v1): a wide editorial image with the name, badges
  and description beneath, and the price + a labelled add button (the
  vertical-aware "Add to order" / "Add to cart" word) — for fine dining and
  short menus. Same hooks, params and shared parts as card-photo; `add_label` is the
  button text (vocab.add_to_cart).
  Params: item, allow_order, show_desc, show_rating, show_badges,
  show_image, show_fav, catalog, eager, add_label.
{%- endcomment -%}
<article class="mbs-card-magazine{% if item.is_sold_out %} is-out{% endif %}"{% if catalog %} data-mb-item="{{ item.id }}" data-mb-name="{{ item.name | escape }}" data-mb-price="{{ item.price }}" data-mb-rating="{{ item.rating }}"{% if item.is_popular %} data-mb-popular{% endif %}{% if item.is_vegan %} data-mb-veg{% endif %}{% if item.is_halal %} data-mb-halal{% endif %}{% if item.is_gluten_free %} data-mb-gf{% endif %}{% if item.is_daily_special %} data-mb-special{% endif %}{% endif %}>
  {%- if show_image and item.image -%}
  <div class="mbs-card-magazine__media">
    {%- assign src = item.image | media_url: 'menu' -%}
    {%- capture img_class -%}mbs-card-photo__img{% if item.is_sold_out %} mbs-card-photo__img--out{% endif %}{%- endcapture -%}
    {%- render 'media', src: src, alt: item.name, width: 960, height: 600, class: img_class, priority: eager, sizes: '(min-width: 768px) 480px, 100vw' -%}
  </div>
  {%- endif -%}
  <div class="mbs-card-magazine__body">
    <div class="mbs-card-magazine__top">
      <h3 class="mbs-card-magazine__name"><a class="mbs-card-photo__link" href="?item={{ item.id }}" data-mb-open="{{ item.id }}">{{ item.name | escape }}</a></h3>
      {%- if show_fav -%}<button type="button" class="mbs-card-photo__fav mbs-card-magazine__fav" data-mb-fav="{{ item.id }}" aria-pressed="false" aria-label="{{ 'Save to favorites' | t }}: {{ item.name | escape }}">{%- render 'icon', name: 'heart', size: 18 -%}</button>{%- endif -%}
    </div>
    {%- if show_badges -%}{%- render 'badges', item: item, offer: true -%}{%- endif -%}
    {%- if show_desc and item.description -%}<p class="mbs-card-magazine__desc">{{ item.description | escape }}</p>{%- endif -%}
    {%- if show_rating -%}{%- render 'rating-stars', rating: item.rating, count: item.rating_count -%}{%- endif -%}
    <div class="mbs-card-magazine__foot">
      {%- render 'price', amount: item.price, original: item.original_price, from: item.has_variants -%}
      {%- if item.is_sold_out -%}
        <span class="mbs-card-photo__out">{{ 'Sold out' | t }}</span>
      {%- elsif allow_order -%}
        <button type="button" class="mbs-card-magazine__add" data-mb-add="{{ item.id }}">{{ add_label | escape }}<span class="mbs-card-magazine__sr">: {{ item.name | escape }}</span></button>
      {%- endif -%}
    </div>
  </div>
</article>
