{%- comment -%}
  Compact tile (library v1): square image, name, price and add — for dense
  grids, rails and the offers strip. Descriptions are never shown; badges
  show only the first one (offer % first). Same hooks, params and
  shared parts as card-photo.
  Params: item, allow_order, show_desc, show_rating, show_badges,
  show_image, show_fav, catalog, eager.
{%- endcomment -%}
<article class="mbs-card-compact{% if item.is_sold_out %} is-out{% endif %}"{% if catalog %} data-mb-item="{{ item.id }}" data-mb-name="{{ item.name | escape }}" data-mb-price="{{ item.price }}" data-mb-rating="{{ item.rating }}"{% if item.is_popular %} data-mb-popular{% endif %}{% if item.is_vegan %} data-mb-veg{% endif %}{% if item.is_halal %} data-mb-halal{% endif %}{% if item.is_gluten_free %} data-mb-gf{% endif %}{% if item.is_daily_special %} data-mb-special{% endif %}{% endif %}>
  {%- if show_image -%}
  <div class="mbs-card-compact__media">
    {%- if item.image -%}
      {%- assign src = item.image | media_url: 'menu' -%}
      {%- capture img_class -%}mbs-card-photo__img{% if item.is_sold_out %} mbs-card-photo__img--out{% endif %}{%- endcapture -%}
      {%- render 'media', src: src, alt: item.name, width: 320, height: 320, class: img_class, priority: eager, sizes: '160px' -%}
    {%- endif -%}
    {%- if show_badges -%}{%- render 'badges', item: item, offer: true -%}{%- endif -%}
    {%- if item.is_sold_out -%}<span class="mbs-card-photo__out mbs-card-compact__out">{{ 'Sold out' | t }}</span>{%- endif -%}
  </div>
  {%- elsif item.is_sold_out -%}<span class="mbs-card-photo__out mbs-card-compact__out">{{ 'Sold out' | t }}</span>
  {%- endif -%}
  <h3 class="mbs-card-compact__name"><a class="mbs-card-photo__link" href="?item={{ item.id }}" data-mb-open="{{ item.id }}">{{ item.name | escape }}</a></h3>
  {%- if show_rating -%}{%- render 'rating-stars', rating: item.rating, count: item.rating_count -%}{%- endif -%}
  <div class="mbs-card-compact__foot">
    {%- render 'price', amount: item.price, original: item.original_price, from: item.has_variants -%}
    {%- if allow_order and item.is_sold_out == false -%}<button type="button" class="mbs-card-photo__add" data-mb-add="{{ item.id }}" aria-label="{{ 'Add' | t }}: {{ item.name | escape }}"></button>{%- endif -%}
  </div>
</article>
