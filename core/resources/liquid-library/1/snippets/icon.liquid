{%- comment -%}
  Inline SVG icon (library v1). Decorative by default (aria-hidden): the
  control that carries it owns the accessible name. Stroke icons inherit
  currentColor, so tokens colour them through the parent.
  Params: name (string), size (number, px).
{%- endcomment -%}
{%- assign px = size | default: 20 -%}
<svg class="mbs-icon mbs-icon--{{ name }}" width="{{ px }}" height="{{ px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{%- case name -%}
{%- when 'cart' -%}<path d="M5 8h14l-1.2 12H6.2L5 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>
{%- when 'user' -%}<circle cx="12" cy="8" r="3.6"/><path d="M5 20a7 7 0 0 1 14 0"/>
{%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14 0 18M12 3c-3 3.5-3 14 0 18"/>
{%- when 'home' -%}<path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v10h12V10"/>
{%- when 'menu' -%}<path d="M4 6h16M4 12h16M4 18h10"/>
{%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/>
{%- when 'heart' -%}<path d="M12 20.5s-8-4.9-8-10.6C4 6.6 6.4 4.5 9 4.5c1.5 0 2.5.9 3 1.7.5-.8 1.5-1.7 3-1.7 2.6 0 5 2.1 5 5.4 0 5.7-8 10.6-8 10.6Z"/>
{%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
{%- when 'pin' -%}<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>
{%- when 'phone' -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>
{%- when 'star' -%}<path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9L12 3.5Z"/>
{%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
{%- when 'chevron' -%}<path d="m15 5-7 7 7 7"/>
{%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- when 'map' -%}<path d="m9 4-5 2v14l5-2 6 2 5-2V4l-5 2-6-2Z"/><path d="M9 4v14M15 6v14"/>
{%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17" cy="7" r=".6"/>
{%- when 'facebook' -%}<path d="M14 21v-7.5h2.6l.4-3H14V8.6c0-.9.3-1.5 1.6-1.5H17V4.4A20 20 0 0 0 14.8 4C12.6 4 11 5.4 11 7.9v2.6H8.5v3H11V21"/>
{%- when 'whatsapp' -%}<path d="M4 20l1.2-4A8 8 0 1 1 8 18.8L4 20Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.4-1.8-.9-.9.8a4 4 0 0 1-2.3-2.3l.8-.9-.9-1.8L9 9.5Z"/>
{%- when 'review' -%}<path d="M4 5h16v11H9l-5 4V5Z"/><path d="m12 7.8.9 1.8 2 .3-1.4 1.4.3 2-1.8-1-1.8 1 .3-2-1.4-1.4 2-.3.9-1.8Z"/>
{%- else -%}<circle cx="12" cy="12" r="3"/>
{%- endcase -%}
</svg>