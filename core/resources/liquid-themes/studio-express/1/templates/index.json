{
  "sections": {
    "announcement": {
      "type": "announcement-bar",
      "settings": {
        "source": "store",
        "tone": "primary",
        "dismissible": true
      }
    },
    "header": {
      "type": "header",
      "settings": {
        "variant": "minimal",
        "sticky": true,
        "show_tagline": false,
        "logo_size": 36
      }
    },
    "status": {
      "type": "store-status",
      "settings": {
        "show_today": true
      }
    },
    "search": {
      "type": "search-bar",
      "settings": {
        "sticky": true
      }
    },
    "catnav": {
      "type": "category-nav",
      "settings": {
        "variant": "tabs",
        "sticky": true
      }
    },
    "offers": {
      "type": "offers-strip",
      "settings": {
        "show_images": false
      }
    },
    "featured": {
      "type": "featured-rail",
      "settings": {
        "source": "popular",
        "card": "compact",
        "limit": 8
      }
    },
    "menu": {
      "type": "menu-grid",
      "settings": {
        "card": "list-row",
        "columns_mobile": 1,
        "columns_desktop": 2,
        "show_description": false,
        "show_rating": false
      }
    },
    "footer": {
      "type": "footer",
      "settings": {
        "tone": "surface",
        "show_social": false
      }
    },
    "cart-bar": {
      "type": "floating-cart",
      "settings": {
        "style": "bar",
        "show_total": true,
        "above_tabbar": true
      }
    },
    "tabbar": {
      "type": "bottom-tabbar",
      "settings": {
        "style": "bar",
        "show_labels": true
      },
      "blocks": {
        "tab-home": {
          "type": "tab",
          "settings": {
            "target": "home"
          }
        },
        "tab-catalog": {
          "type": "tab",
          "settings": {
            "target": "catalog",
            "anchor": "menu"
          }
        },
        "tab-search": {
          "type": "tab",
          "settings": {
            "target": "search"
          }
        },
        "tab-cart": {
          "type": "tab",
          "settings": {
            "target": "cart"
          }
        },
        "tab-profile": {
          "type": "tab",
          "settings": {
            "target": "profile"
          }
        }
      },
      "block_order": [
        "tab-home",
        "tab-catalog",
        "tab-search",
        "tab-cart",
        "tab-profile"
      ]
    }
  },
  "order": [
    "announcement",
    "header",
    "status",
    "search",
    "catnav",
    "offers",
    "featured",
    "menu",
    "footer",
    "cart-bar",
    "tabbar"
  ]
}