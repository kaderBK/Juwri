{% comment %}
  bazaar (Liquid) — a complete goods/services storefront, built on the same
  SPA-shell idiom as the crave reference theme (search / favourites /
  language switch / cart / checkout / account + the P8-3 view router all come
  from the platform commerce runtime via data-mb-* bindings, ZERO theme JS).
  Unlike crave, every noun runs through the vocab global instead of being
  hardcoded to food words, and the food-only surface (dietary filters, call
  waiter) is left out entirely — the SAME package renders correctly for a
  goods store ("Products"/"Catalog"/"Add to cart") or a services store
  ("Services"/"Bookings"/"Book"). Data is the P2-2 Drop contract; every DB
  string is escaped.
{% endcomment %}
<link rel="stylesheet" href="{{ 'css/style.css' | theme_asset }}">

<div class="bz-lq" id="bazaar-lq">

  {% comment %} One-time splash intro (runtime shows once/session, tap to skip) {% endcomment %}
  <div class="bz-splash" data-mb-splash hidden aria-hidden="true">
    <div class="bz-splash-inner">
      {% if restaurant.logo %}<img class="bz-splash-logo" src="{{ restaurant.logo | media_url: 'logo' }}" alt="">{% endif %}
      <h1 class="bz-splash-title">{{ restaurant.title | escape }}</h1>
      {% if restaurant.sub_title %}<p>{{ restaurant.sub_title | escape }}</p>{% endif %}
      <span class="bz-splash-skip">{{ 'Tap to continue' | t }}</span>
    </div>
  </div>

  <main class="bz-views">

  {% comment %} ══════════ HOME ══════════ {% endcomment %}
  <section class="bz-view is-active" data-mb-view="home">
    <div class="bz-view-scroll" data-mb-view-scroll>

      <header class="bz-top">
        <span class="bz-avatar">
          {% if restaurant.logo %}<img src="{{ restaurant.logo | media_url: 'logo' }}" alt="{{ restaurant.title | escape }}">{% endif %}
        </span>
        <div class="bz-id">
          <h1 class="bz-title">{{ restaurant.title | escape }}</h1>
          {% if restaurant.sub_title %}<p class="bz-sub">{{ restaurant.sub_title | escape }}</p>{% endif %}
        </div>

        {% comment %} Open/closed + branch status badge — generic across every vertical {% endcomment %}
        {% if active_branch %}
          <span class="bz-badge {% if active_branch.accepts_orders %}is-open{% else %}is-closed{% endif %}">
            {% if active_branch.accepts_orders %}{{ 'Open' | t }}{% else %}{{ 'Closed' | t }}{% endif %} · {{ active_branch.name | escape }}
          </span>
        {% elsif options.open_close_store %}
          <span class="bz-badge is-open">{{ 'Open' | t }}</span>
        {% else %}
          <span class="bz-badge is-closed">{{ 'Closed' | t }}</span>
        {% endif %}

        {% comment %} Language + currency: a globe icon opens the sheet below {% endcomment %}
        {% assign lang_count = localization.languages | size %}
        {% assign cur_count = localization.currencies | size %}
        {% if lang_count > 1 or cur_count > 1 %}
          <button type="button" class="bz-globe" data-mb-lang-open aria-label="{{ 'Language' | t }}" aria-haspopup="dialog">
            <svg class="bz-ic" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14 0 18M12 3c-3 3.5-3 14 0 18"/></svg>
          </button>
        {% endif %}
      </header>

      {% if customer %}<p class="bz-hello">{{ 'Welcome' | t }}, {{ customer.name | escape }}</p>{% endif %}

      {% comment %} Banners {% endcomment %}
      {% assign banner_count = banners | size %}
      {% if banner_count > 0 %}
        <section class="bz-banners" aria-label="{{ 'Offers' | t }}" data-mb-slider data-mb-slider-interval="5000">
          {% for banner in banners %}
            <figure class="bz-banner">
              {% if banner.image_url %}<img src="{{ banner.image_url }}" alt="{{ banner.title | escape }}" loading="lazy">{% endif %}
              <figcaption>
                {% if banner.title %}<b>{{ banner.title | escape }}</b>{% endif %}
                {% if banner.subtitle %}<span>{{ banner.subtitle | escape }}</span>{% endif %}
              </figcaption>
            </figure>
          {% endfor %}
        </section>
      {% endif %}

      {% comment %}
        Search + favourite/featured filters. No dietary chips here (vegan/
        halal/gluten-free are food-only) — All / Favourites / Featured cover
        every vertical. Shown whenever there's a catalog to search, whether
        or not ordering itself is switched on (browse-only stores still want
        search).
      {% endcomment %}
      {% unless menu.is_empty %}
        <div class="bz-tools">
          <input class="bz-search" type="search" data-mb-search placeholder="{{ 'Search' | t }}" aria-label="{{ 'Search' | t }}">
          <div class="bz-filters">
            <button type="button" class="bz-filter is-on" data-mb-filter="all">{{ 'All' | t }}</button>
            <button type="button" class="bz-filter" data-mb-filter="fav">♥ <span data-mb-fav-count>0</span></button>
            <button type="button" class="bz-filter" data-mb-filter="special">{{ 'Featured' | t }}</button>
          </div>
        </div>
      {% endunless %}

      {% unless menu.is_empty %}
      <nav class="bz-chips" aria-label="{{ vocab.categories }}">
        {% for category in menu.categories %}
          <a class="bz-chip" href="#bz-cat-{{ category.id }}" aria-label="{{ vocab.category }}: {{ category.name | escape }}">
            {% if category.image_url %}<img class="bz-chip-img" src="{{ category.image_url }}" alt="" loading="lazy">{% endif %}
            {{ category.name | escape }}
          </a>
        {% endfor %}
      </nav>

      {% comment %} Featured picks — a generic "highlighted items" rail, not a food-only concept {% endcomment %}
      {% assign featured = menu.items | where: 'is_daily_special', true %}
      {% assign featured_count = featured | size %}
      {% if featured_count > 0 %}
        <section class="bz-cat bz-featured" data-mb-cat>
          <h2 class="bz-cat-title">★ {{ 'Featured' | t }}</h2>
          <div class="bz-grid">
            {% for item in featured %}{% render 'product-card', item: item, flags: flags, vocab: vocab %}{% endfor %}
          </div>
        </section>
      {% endif %}

      {% comment %} Sort + layout controls (runtime reorders the DOM cards) {% endcomment %}
      <div class="bz-catalog-head">
        <div class="bz-catalog-heading">
          <h2>{{ vocab.catalog }}</h2>
          <p class="bz-catalog-count">{{ menu.items | size }} {{ vocab.items }}</p>
        </div>
        <label class="bz-sort">
          <select data-mb-sort aria-label="{{ 'Sort' | t }}">
            <option value="featured">{{ 'Featured' | t }}</option>
            <option value="price_asc">{{ 'Price: low to high' | t }}</option>
            <option value="price_desc">{{ 'Price: high to low' | t }}</option>
            <option value="rating">{{ 'Top rated' | t }}</option>
          </select>
        </label>
        <button type="button" class="bz-layout" data-mb-layout-toggle aria-label="{{ 'Toggle layout' | t }}" aria-pressed="false">
          <svg class="bz-ic" viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2"/></svg>
        </button>
      </div>

      <div data-mb-catalog>
      {% for category in menu.categories %}
        <section class="bz-cat" id="bz-cat-{{ category.id }}" data-mb-cat>
          <h2 class="bz-cat-title">
            {% if category.image_url %}<img class="bz-cat-img" src="{{ category.image_url }}" alt="" loading="lazy">{% endif %}
            {{ category.name | escape }}
          </h2>
          <div class="bz-grid">
            {% for item in category.items %}{% render 'product-card', item: item, flags: flags, vocab: vocab %}{% endfor %}
          </div>
        </section>
      {% endfor %}
        <div class="bz-empty" data-mb-empty hidden>
          <p>{{ 'Nothing matches — try clearing filters' | t }}</p>
        </div>
      </div>
      {% else %}
        <p class="bz-empty-catalog">{{ 'Nothing here yet' | t }}</p>
      {% endunless %}

      <footer class="bz-foot">
        {% if restaurant.address %}<p>{{ restaurant.address | escape }}</p>{% endif %}
        {% if restaurant.phone %}<p><a href="tel:{{ restaurant.phone | escape }}">{{ restaurant.phone | escape }}</a></p>{% endif %}
        <p class="bz-foot-meta">{{ stats.scans_today }} {{ 'scans today' | t }}</p>
      </footer>
      <div class="bz-tail"></div>
    </div>
  </section>

  {% comment %} ══════════ FAVOURITES ══════════ {% endcomment %}
  <section class="bz-view" data-mb-view="favs">
    <div class="bz-view-scroll" data-mb-view-scroll>
      <header class="bz-page-head"><h1 class="bz-title">{{ 'Favorites' | t }}</h1></header>
      <div class="bz-fav-list" data-mb-favs-mount></div>
      <div class="bz-tail"></div>
    </div>
  </section>

  {% comment %} ══════════ CART ══════════ {% endcomment %}
  {% if flags.allow_order %}
  <section class="bz-view" data-mb-view="cart">
    <div class="bz-view-scroll" data-mb-view-scroll>
      <header class="bz-page-head"><h1 class="bz-title">{{ 'My Cart' | t }}</h1></header>
      <div class="bz-cart-inview" data-mb-cart-mount></div>
      <div class="bz-tail"></div>
    </div>
  </section>
  {% endif %}

  {% comment %} ══════════ ACCOUNT / PROFILE ══════════ {% endcomment %}
  <section class="bz-view" data-mb-view="profile">
    <div class="bz-view-scroll" data-mb-view-scroll>
      <header class="bz-page-head"><h1 class="bz-title">{{ 'Account' | t }}</h1></header>
      <div class="bz-acct-inview" data-mb-account-mount></div>
      <div class="bz-tail"></div>
    </div>
  </section>

  {% comment %} ══════════ PRODUCT (sub-view — runtime renders here) ══════════ {% endcomment %}
  <section class="bz-view bz-view-product" data-mb-view="product">
    <div class="bz-view-scroll" data-mb-view-scroll>
      <div data-mb-product-mount></div>
    </div>
  </section>

  {% comment %} ══════════ CONFIRMED (sub-view — after an order) ══════════ {% endcomment %}
  <section class="bz-view bz-view-confirmed" data-mb-view="confirmed">
    <div class="bz-view-scroll" data-mb-view-scroll>
      <div data-mb-confirmed-mount></div>
    </div>
  </section>

  </main>

  {% comment %} Option sheet overlay kept as a fallback for no-product-view themes {% endcomment %}
  <div class="bz-mount" data-mb-item-sheet-mount hidden></div>

  {% comment %} Bottom tab bar — the SPA router drives is-active + the badge {% endcomment %}
  <nav class="bz-tabbar" data-mb-tabbar aria-label="{{ 'Navigation' | t }}">
    <button class="bz-tab is-on" type="button" data-mb-tab="home">
      <span class="bz-tab-pill"><svg class="bz-ic" viewBox="0 0 24 24"><path d="M4 11.5 12 4l8 7.5M6 10v9h12v-9"/></svg></span>
      <span class="bz-tab-label">{{ 'Home' | t }}</span>
    </button>
    <button class="bz-tab" type="button" data-mb-tab="favs">
      <span class="bz-tab-pill"><svg class="bz-ic" viewBox="0 0 24 24"><path d="M12 20.5s-8-4.9-8-10.6C4 6.6 6.4 4.5 9 4.5c1.5 0 2.5.9 3 1.7.5-.8 1.5-1.7 3-1.7 2.6 0 5 2.1 5 5.4 0 5.7-8 10.6-8 10.6Z"/></svg></span>
      <span class="bz-tab-label">{{ 'Favorites' | t }}</span>
    </button>
    {% if flags.allow_order %}
    <button class="bz-tab" type="button" data-mb-tab="cart">
      <span class="bz-tab-pill"><svg class="bz-ic" viewBox="0 0 24 24"><path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/></svg><i class="bz-tab-badge" data-mb-cart-count data-mb-hide-empty hidden>0</i></span>
      <span class="bz-tab-label">{{ 'Cart' | t }}</span>
    </button>
    {% endif %}
    <button class="bz-tab" type="button" data-mb-tab="profile">
      <span class="bz-tab-pill"><svg class="bz-ic" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.6"/><path d="M5 20a7 7 0 0 1 14 0"/></svg></span>
      <span class="bz-tab-label">{{ 'Account' | t }}</span>
    </button>
  </nav>

  {% comment %} Language + currency sheet (opened by the header globe icon) {% endcomment %}
  {% assign lang_count = localization.languages | size %}
  {% assign cur_count = localization.currencies | size %}
  {% if lang_count > 1 or cur_count > 1 %}
  <div class="bz-sheet" data-mb-lang-sheet hidden>
    <div class="bz-sheet-scrim" data-mb-lang-close></div>
    <div class="bz-sheet-panel" role="dialog" aria-modal="true" aria-label="{{ 'Language' | t }}">
      <header class="bz-sheet-head"><b>{{ 'Language' | t }}</b>
        <button type="button" class="mb-sheet-close" data-mb-lang-close aria-label="{{ 'Close' | t }}">&times;</button></header>
      {% if lang_count > 1 %}
        <div class="bz-sheet-opts">
          {% for language in localization.languages %}
            <button type="button" class="bz-sheet-opt{% if localization.current and language.code == localization.current.code %} is-on{% endif %}"
                    data-mb-set-lang="{{ language.code }}">{{ language.name | escape }}<span>{{ language.code | upcase }}</span></button>
          {% endfor %}
        </div>
      {% endif %}
      {% if cur_count > 1 %}
        <b class="bz-sheet-sub">{{ 'Currency' | t }}</b>
        <div class="bz-sheet-opts">
          {% for c in localization.currencies %}
            <button type="button" class="bz-sheet-opt{% if forloop.first %} is-on{% endif %}" data-mb-currency="{{ c.code }}">{{ c.code }}</button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
</div>

{% commerce %}
