  {
    "id": 97,
    "name": "email_message_signup_details",
    "value": "\"<p>Dear Valued Thanks for creating an account with {SITE_TITLE} ,</p>\\n<p>Your username: {USERNAME}</p>\\n<p>Have further questions?</p>\\n<p>You can start chat with live support team. Sincerely,</p>\\n<p>{SITE_TITLE} Team!</p>\\n<p>{SITE_URL}</p>\"",
    "created_at": "@now",
    "updated_at": "@now"
  },
  {
    "id": 98,
    "name": "email_message_signup_confirm",
    "value": "\"<p>Greetings from {SITE_TITLE} Team!</p>\\n<p>Thanks for registering with {SITE_TITLE}. We are thrilled to have you as a registered member and hope that you find our service beneficial. Before we get you started please activate your account by clicking on the link below</p>\\n<p><a href=\\\"{CONFIRMATION_LINK}\\\">{CONFIRMATION_LINK}</a></p>\\n<p>After your Account activation you can access the website. Once you have your Profile filled in you are ready to go.</p>\\n<p>{SITE_TITLE} Team!</p>\\n<p>{SITE_URL}</p>\"",
    "created_at": "@now",
    "updated_at": "@now"
  },
  {
    "id": 99,
    "name": "email_message_forgot_pass",
    "value": "\"<p>To reset your password please click the link below<br><br>{FORGET_PASSWORD_LINK}</p>\\n<p>{SITE_TITLE} Team!</p>\\n<p>{SITE_URL}</p>\"",
    "created_at": "@now",
    "updated_at": "@now"
  },
