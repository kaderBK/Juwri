                "sql": "select * from \"service_requests\" where \"service_requests\".\"store_id\" is null and \"service_requests\".\"store_id\" is not null",
                "eager": []
            },
            "storeReviews": {
                "type": "HasMany",
                "related": "App\\Models\\StoreReview",
                "sql": "select * from \"store_reviews\" where \"store_reviews\".\"store_id\" is null and \"store_reviews\".\"store_id\" is not null",
                "eager": []
            },
            "tables": {
                "type": "HasMany",
                "related": "App\\Models\\StoreTable",
                "sql": "select * from \"store_tables\" where \"store_tables\".\"store_id\" is null and \"store_tables\".\"store_id\" is not null",
                "eager": []
            },
            "user": {
                "type": "BelongsTo",
                "related": "Juwri\\Core\\Models\\User",
                "sql": "select * from \"users\" where \"users\".\"id\" is null",
                "eager": []
            },
            "views": {
