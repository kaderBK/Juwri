    "Juwri\\Core\\Models\\Store": {
        "table": "stores",
        "key": "id",
        "incrementing": true,
        "timestamps": true,
        "fillable": [],
        "guarded": [],
        "casts": {
            "id": "int",
            "is_verified": "boolean",
            "mk_enabled": "boolean",
