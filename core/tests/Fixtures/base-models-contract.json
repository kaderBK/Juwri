            "mk_min_order_minor": "integer"
        },
        "hidden": [
            "settings"
        ],
        "sluggable": {
            "slug": {
                "source": "title"
            }
        },
        "relations": {
            "account": {
                "type": "BelongsTo",
                "related": "Juwri\\Core\\Models\\Account",
                "sql": "select * from \"accounts\" where \"accounts\".\"id\" is null",
                "eager": []
            },
            "branches": {
                "type": "HasMany",
                "related": "Juwri\\Core\\Models\\Branch",
                "sql": "select * from \"branches\" where \"branches\".\"store_id\" is null and \"branches\".\"store_id\" is not null order by \"position\" asc",
                "eager": []
            },
            "cuisines": {
                "type": "BelongsToMany",
                "related": "App\\Models\\Cuisine",
                "sql": "select * from \"cuisines\" inner join \"cuisine_store\" on \"cuisines\".\"id\" = \"cuisine_store\".\"cuisine_id\" where \"cuisine_store\".\"store_id\" is null",
                "eager": []
            },
            "follows": {
                "type": "HasMany",
                "related": "App\\Models\\StoreFollow",
                "sql": "select * from \"store_follows\" where \"store_follows\".\"store_id\" is null and \"store_follows\".\"store_id\" is not null",
                "eager": []
            },
            "hotelStays": {
                "type": "HasMany",
                "related": "Juwri\\Modules\\Hotel\\Models\\HotelStay",
                "sql": "select * from \"hotel_stays\" where \"hotel_stays\".\"store_id\" is null and \"hotel_stays\".\"store_id\" is not null",
                "eager": []
            },
            "image_menus": {
                "type": "HasMany",
                "related": "App\\Models\\ImageMenu",
                "sql": "select * from \"image_menus\" where \"image_menus\".\"store_id\" is null and \"image_menus\".\"store_id\" is not null order by \"position\" asc",
                "eager": []
            },
            "menu_categories": {
                "type": "HasMany",
                "related": "App\\Models\\MenuCategory",
                "sql": "select * from \"categories\" where \"categories\".\"store_id\" is null and \"categories\".\"store_id\" is not null and \"active\" = ? and \"parent\" is null order by \"position\" asc",
                "eager": [
                    "subcategories"
                ]
            },
            "menu_categories_with_items": {
                "type": "HasMany",
                "related": "App\\Models\\MenuCategory",
                "sql": "select * from \"categories\" where \"categories\".\"store_id\" is null and \"categories\".\"store_id\" is not null and \"active\" = ? and \"parent\" is null order by \"position\" asc",
                "eager": [
                    "subcategories",
                    "subcategories.menus",
                    "menus"
                ]
            },
            "mkCity": {
                "type": "BelongsTo",
                "related": "Juwri\\Core\\Models\\City",
                "sql": "select * from \"cities\" where \"cities\".\"id\" is null",
                "eager": []
            },
            "serviceRequests": {
                "type": "HasMany",
